class OnScreenDisplay:
    """Discrete on-screen display on its own ARGB plane.

    Two geometries share the plane:

      - the bottom band (default 76 px), with an optional progress bar (seek
        position or volume level), a left label ("+10 s", "Pause",
        "Sous-titres : Français") and an optional right label ("12:34 / 48:45");
      - the information panel, a PANEL_WIDTH rectangle in the top left corner
        with four lines (decode tier, codec, plane, screen) or five when the
        file name is added. It is shown once for PANEL_SECONDS after playback
        is confirmed, and on demand with the I key.

The plane is the OSD plane either way: the board has only two ARGB planes in
total (subtitles + OSD), so the panel reuses the OSD one with its own
rectangle. The two can never be visible at once, and the rules differ by
trigger: the startup panel is superseded by a band render and cancelled by
any key; the on-demand panel (kind "manual") is hidden only by a second I,
and the bottom band is suppressed while it is up so seeking does not wipe it.

Refresh is event driven. The band is rate limited to 10 Hz (see show()); the
panel fade is the single bounded exception: 12 renders at 67 ms, then it
removes its own timer and clears the plane.
    """

    def __init__(self, subdaemon, width, screen_height, band_height=None):
        self.subdaemon = subdaemon
        self.width = width
        self.screen_height = screen_height
        self.band_height = band_height or int(os.environ.get("KMS_OSD_HEIGHT", "76"))
        self.y = screen_height - self.band_height
        self.surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, self.width, self.band_height)
        self.ctx = cairo.Context(self.surface)
        self.layout = PangoCairo.create_layout(self.ctx)
        self.layout.set_font_description(Pango.FontDescription("Sans 14"))
        self.layout.set_width(-1)
        self.state = {}
        self.visible = False
        self.persistent = False
        self.hide_at = 0.0
        self.last_render = 0.0
        self.pending = False
        self.enabled = True         # toggled by ENTER

        # Information-panel state. panel_visible covers both the plateau and
        # the fade; panel_kind says which trigger owns the plane ("startup"
        # or "manual"). The surface is allocated on first use: the panel never
        # shows in a run where decode fails.
        self.panel_visible = False
        self.panel_fading = False
        self.panel_kind = None
        self.panel_hide_at = 0.0
        self.panel_lines = []
        self.panel_surface = None
        self.panel_ctx = None
        self.panel_layout = None
        self.fade_started = 0.0
        self.fade_source = 0        # GLib timeout id while fading

    # -- buffer plumbing ---------------------------------------------------

    def _blank_band_file(self):
        """Overwrite the OSD buffer with a fully transparent band surface.

        kms-subd detaches the plane on clear, but the raw file stays on disk:
        without this, kms-shot would keep reading the last drawn content and
        report "overlay visible" long after it disappeared. The band geometry
        is used because that is what the next render will use."""
        ctx = self.ctx
        ctx.set_operator(cairo.OPERATOR_SOURCE)
        ctx.set_source_rgba(0, 0, 0, 0)
        ctx.paint()
        self.surface.flush()
        write_surface(RAW_OSD, RAW_OSD_GEOM, self.surface, self.width, self.band_height)

    def _panel_blocks_band(self):
        """True while the on-demand panel must keep the bottom band away.

        The startup panel is transient and informational; the viewer can wait
        or press a key. The on-demand panel is read deliberately, possibly
        while seeking, so the band would destroy it: it stays until I or the
        timer ends it."""
        return self.panel_visible and self.panel_kind == "manual"

    # -- bottom band -------------------------------------------------------

    def _render(self):
        """Draw the band and push it to the plane. Returns draw ms."""
        started = monotonic()
        if self.panel_visible:
            if self._panel_blocks_band():
                # show() never gets here in that state; this is a safety net
                # for a render queued before the panel appeared.
                log("osd: suppressed, info panel visible")
                return 0.0
            # A band render always wins over the startup panel: its rectangle
            # replaces the panel's on the same plane, so the panel state must
            # not survive and later clear the plane under the band.
            log("panel: superseded by osd")
            self._reset_panel()
        ctx = self.ctx
        width, height = self.width, self.band_height
        state = self.state
        fraction = state.get("fraction")
        margin, bar_y, bar_h = 24, 14, 5

        # 55 % black: readable over any scene, still lets the video through.
        ctx.set_operator(cairo.OPERATOR_SOURCE)
        ctx.set_source_rgba(0, 0, 0, 0.55)
        ctx.paint()
        ctx.set_operator(cairo.OPERATOR_OVER)

        if fraction is not None:
            fraction = max(0.0, min(1.0, float(fraction)))
            ctx.set_source_rgba(1, 1, 1, 0.20)
            ctx.rectangle(margin, bar_y, width - 2 * margin, bar_h)
            ctx.fill()
            if fraction > 0:
                ctx.set_source_rgba(1, 1, 1, 0.90)
                ctx.rectangle(margin, bar_y, (width - 2 * margin) * fraction, bar_h)
                ctx.fill()

        ctx.set_source_rgba(1, 1, 1, 0.92)
        ctx.move_to(margin, 32)
        self.layout.set_text(state.get("label", "") or "", -1)
        PangoCairo.show_layout(ctx, self.layout)

        right = state.get("right", "") or ""
        if right:
            self.layout.set_text(right, -1)
            _, extents = self.layout.get_pixel_extents()
            ctx.move_to(width - margin - extents.width, 32)
            PangoCairo.show_layout(ctx, self.layout)

        self.surface.flush()
        write_surface(RAW_OSD, RAW_OSD_GEOM, self.surface, self.width, self.band_height)
        self.subdaemon.stdin.write("osd cue %d %d %d %d %s\n"
                                   % (0, self.y, self.width, self.band_height, RAW_OSD))
        self.subdaemon.stdin.flush()
        self.visible = True
        self.last_render = monotonic()
        return (self.last_render - started) * 1000

    def show(self, label="", fraction=None, right="", duration=1.2, persistent=False):
        """Display a message for `duration` seconds (or until replaced).

        Rate limited to ~10 Hz: if a render happened less than 95 ms ago, the
        request is only remembered (self.pending) and tick() renders it later.
        This keeps fast key bursts from flooding the DRM plane."""
        if not self.enabled:
            return
        if self._panel_blocks_band():
            # The panel is being read on purpose; a seek or a volume change
            # must not replace it. The action itself still happens.
            log("osd: suppressed while the info panel is up:", label or "-")
            return
        self.state = {"label": label, "fraction": fraction, "right": right}
        self.persistent = persistent
        self.hide_at = monotonic() + duration
        if monotonic() - self.last_render < 0.095:
            self.pending = True
            return
        elapsed_ms = self._render()
        log("osd:", label or "-", right, "| render %.1f ms" % elapsed_ms)

    # -- information panel -------------------------------------------------

    def show_panel(self, lines, kind="startup", duration=None):
        """Display the information panel in the top left corner.

        One renderer, two triggers. `kind="startup"` is the automatic banner:
        four lines, cancelled by the first key or superseded by a band render.
        `kind="manual"` is the on-demand panel (key I): the same lines plus
        the file name, hidden only by a second I or by its timer, while the
        bottom band stays away under it.

        `lines` are already formatted by the player; at most PANEL_MAX_LINES
        are drawn and the box height follows their count."""
        if not self.enabled:
            return
        duration = PANEL_SECONDS if duration is None else duration
        lines = [line for line in lines if line][:PANEL_MAX_LINES]
        if not lines:
            return
        self._reset_panel()
        self.panel_lines = lines
        self.panel_kind = kind
        self.panel_visible = True
        self.panel_hide_at = monotonic() + duration
        # The band is gone even if it was visible a moment ago: its rectangle
        # has been replaced by the panel's.
        self.visible = False
        self.pending = False
        elapsed_ms = self._render_panel(1.0)
        log("panel: shown (%s) for %.1f s |" % (kind, duration),
            " | ".join(lines), "| render %.1f ms" % elapsed_ms)

    def _fit_middle(self, text, max_width):
        """Shorten a line in the middle until it fits, keeping the extension.

        Filenames are the reason this exists: the end of the name carries the
        release tag and the extension, which is what the viewer recognises, so
        the middle is what gets dropped. Measurement is done with the real
        Pango layout, so the result fits whatever font ends up being used.

        The layout is measured unwrapped (width -1): with the drawing width
        set, Pango would report the wrapped block width instead of the natural
        line width, every long name would look like it fits and would silently
        wrap onto a second line outside the box."""
        layout = self.panel_layout
        layout.set_width(-1)
        try:
            layout.set_text(text, -1)
            if layout.get_pixel_extents()[1].width <= max_width:
                return text
            # Cut at a dot rather than at a fixed offset: the tail then holds
            # whole tokens plus the extension ("x265-TAC.mkv"), which is the
            # part a viewer recognises, instead of a stray digit.
            extension = os.path.splitext(text)[1]
            kept = []
            for part in reversed(text.split(".")):
                length = sum(len(p) for p in kept) + len(part) + len(kept)
                if kept and length > 13:
                    break
                kept.insert(0, part)
            tail = ".".join(kept)
            head = text[:len(text) - len(tail)].rstrip(".")
            while True:
                candidate = (head + "…" + tail) if head else ("…" + tail)
                layout.set_text(candidate, -1)
                if layout.get_pixel_extents()[1].width <= max_width:
                    if not self.panel_fading:
                        # Logged once, on the opaque render: the fade redraws
                        # the same line eleven more times and would add noise.
                        log("panel: shortened:", text, "->", candidate)
                    return candidate
                if len(head) > 1:
                    head = head[:-1]
                elif len(tail) > len(extension) + 1:
                    tail = tail[1:]
                else:
                    return candidate
        finally:
            layout.set_width((PANEL_WIDTH - 2 * PANEL_MARGIN) * Pango.SCALE)

    def _render_panel(self, alpha):
        """Draw the panel at the given opacity and push it to the plane."""
        started = monotonic()
        height = panel_height(max(1, len(self.panel_lines)))
        if self.panel_surface is None or self.panel_surface.get_height() != height:
            self.panel_surface = cairo.ImageSurface(cairo.FORMAT_ARGB32,
                                                    PANEL_WIDTH, height)
            self.panel_ctx = cairo.Context(self.panel_surface)
            self.panel_layout = PangoCairo.create_layout(self.panel_ctx)
            self.panel_layout.set_width((PANEL_WIDTH - 2 * PANEL_MARGIN) * Pango.SCALE)
            self.panel_layout.set_wrap(Pango.WrapMode.WORD_CHAR)
            self.panel_layout.set_alignment(Pango.Alignment.LEFT)
        ctx = self.panel_ctx
        # Translucent black box: readable over any picture, and the video is
        # still visible behind it (the VOP blends the plane).
        ctx.set_operator(cairo.OPERATOR_SOURCE)
        ctx.set_source_rgba(0, 0, 0, 0.72 * alpha)
        ctx.paint()
        ctx.set_operator(cairo.OPERATOR_OVER)
        for index, line in enumerate(self.panel_lines):
            # First line is the decode tier: bold, it is the headline.
            desc = Pango.FontDescription("Sans Bold 16" if index == 0 else "Sans 15")
            self.panel_layout.set_font_description(desc)
            text = self._fit_middle(line, PANEL_WIDTH - 2 * PANEL_MARGIN)
            self.panel_layout.set_text(text, -1)
            ctx.set_source_rgba(1, 1, 1, alpha)
            ctx.move_to(PANEL_MARGIN, PANEL_TOP + index * PANEL_LINE_HEIGHT)
            PangoCairo.show_layout(ctx, self.panel_layout)
        self.panel_surface.flush()
        write_surface(RAW_OSD, RAW_OSD_GEOM, self.panel_surface, PANEL_WIDTH, height)
        self.subdaemon.stdin.write("osd cue %d %d %d %d %s\n"
                                   % (PANEL_X, PANEL_Y, PANEL_WIDTH, height, RAW_OSD))
        self.subdaemon.stdin.flush()
        self.last_render = monotonic()
        return (self.last_render - started) * 1000

    def _reset_panel(self):
        """Forget the panel and cancel its fade timer, without touching the
        plane: callers either redraw the plane immediately or clear it."""
        self.panel_visible = False
        self.panel_fading = False
        self.panel_kind = None
        self.panel_lines = []
        if self.fade_source:
            GLib.source_remove(self.fade_source)
            self.fade_source = 0

    def _clear_panel(self, reason):
        """Detach the panel from the plane and blank the captured buffer."""
        kind = self.panel_kind
        self._reset_panel()
        self._blank_band_file()
        self.subdaemon.stdin.write("osd clear\n")
        self.subdaemon.stdin.flush()
        log("panel: hidden (%s, %s)" % (kind, reason))

    def cancel_panel(self, reason="key", kind=None):
        """Drop the panel at once, fade included, and free the plane.

        `kind` restricts which trigger may be cancelled this way: the startup
        panel is dropped by the first key, the on-demand panel only by its own
        key, so a seek does not erase what the viewer is reading.
        Returns True when something was actually cancelled."""
        if not self.panel_visible:
            return False
        if kind is not None and self.panel_kind != kind:
            return False
        self._clear_panel(reason)
        return True

    def hide_panel(self, reason="key I"):
        """Hide the panel whatever its trigger: the I key toggles it off."""
        return self.cancel_panel(reason)

    def _start_fade(self):
        """Begin the one-off fade: 12 renders over PANEL_FADE."""
        self.panel_fading = True
        self.fade_started = monotonic()
        log("panel: fade (%s)" % self.panel_kind)
        # The only animation in the player, and a self-removing one: no timer
        # survives the fade, so idle playback stays event driven.
        self.fade_source = GLib.timeout_add(PANEL_FADE_STEP_MS, self._fade_step)

    def _fade_step(self):
        if not self.panel_visible or not self.panel_fading:
            self.fade_source = 0
            return False
        alpha = 1.0 - (monotonic() - self.fade_started) / PANEL_FADE
        if alpha <= 0:
            self.fade_source = 0
            self._clear_panel("timer")
            return False
        self._render_panel(alpha)
        return True

    def toggle(self):
        self.enabled = not self.enabled
        if not self.enabled:
            self.cancel_panel("osd disabled")
            self.hide()
        return self.enabled

    def hide(self):
        self.pending = False
        if not self.visible:
            return
        self.visible = False
        self.state = {}
        self._blank_band_file()
        self.subdaemon.stdin.write("osd clear\n")
        self.subdaemon.stdin.flush()
        log("osd: hidden")

    def tick(self, now):
        """Housekeeping called at 10 Hz from the GLib loop."""
        if self.panel_visible and not self.panel_fading and now >= self.panel_hide_at:
            self._start_fade()
        if self.pending:
            self.pending = False
            if (self.state and not self._panel_blocks_band()
                    and (self.persistent or now < self.hide_at)):
                self._render()
        if self.visible and not self.persistent and now >= self.hide_at:
            self.hide()
        return True


