def panel_height(line_count):
    """Height of the panel box for a given number of text lines.

    The startup panel has four lines, the on-demand one adds the file name;
    the box follows so neither has a stray black band under the text."""
    return PANEL_TOP + line_count * PANEL_LINE_HEIGHT + PANEL_BOTTOM

