def monotonic():
    return time.monotonic()


def log(*args):
    print("[%.3f]" % monotonic(), *args, file=log_file)


# Last resort VT restore: die() can be called before the Player object exists
# (bad arguments, missing file), so the VT number lives at module level.
ORIGINAL_VT = [None]


def vt_command(action, vt, text=None):
    """Run kms-vt through the single NOPASSWD rule of /etc/sudoers.d/kms-play.

    Non-interactive only: if sudo would need a password we give up silently
    rather than hang on a prompt nobody can see. `text` is the optional status
    line `kms-vt show` prints after clearing; the rule accepts extra arguments
    (verified: a third argument runs without a password)."""
    command = ["sudo", "-n", VT_HELPER, action, str(vt)]
    if text:
        command.append(text)
    return subprocess.run(command, capture_output=True, text=True, check=False)


def active_vt():
    """Number of the VT currently displayed, or None.

    /sys/class/tty/tty0/active is the kernel's own answer ("tty2"), so it is
    also what the exit path verifies against instead of trusting chvt."""
    try:
        with open(ACTIVE_VT_PATH) as handle:
            name = handle.read().strip()
    except OSError:
        return None
    match = re.match(r"tty(\d+)$", name)
    return int(match.group(1)) if match else None


def session_vt():
    """VT of the active graphical session on seat0, or None.

    This is the VT the viewer wants back: the one carrying GNOME. It is asked
    from logind rather than guessed, and a non-numeric or empty answer is
    ignored so a text-only machine simply has no answer here."""
    try:
        seat = subprocess.run(["loginctl", "show-seat", "seat0", "-p", "ActiveSession",
                               "--value"], capture_output=True, text=True, timeout=3)
        session = seat.stdout.strip()
        if not session:
            return None
        show = subprocess.run(["loginctl", "show-session", session, "-p", "VTNr",
                               "--value"], capture_output=True, text=True, timeout=3)
        value = show.stdout.strip()
    except Exception:
        return None
    return int(value) if value.isdigit() else None


def return_vt(previous):
    """The VT to restore: KMS_PLAY_RETURN_VT, else the desktop, else the VT
    that was active before the player took the screen, else 1.

    Returns None when returning is disabled ("none"): the player then stays on
    its own VT, which is the old behaviour and the right one on a machine with
    no desktop. Numeric values win over everything so a test can pin the
    target."""
    setting = RETURN_VT_SETTING.lower()
    if setting == "none":
        return None
    if setting.isdigit():
        return int(setting)
    desktop = session_vt()
    if desktop:
        return desktop
    if previous and str(previous).isdigit():
        return int(previous)
    return 1


def show_status_line(status):
    """Put the exit line on the player's VT and show the cursor there.

    The viewer no longer lands on that VT (the desktop is), so the line is
    invisible on purpose - but it stays readable in /dev/vcsa<player VT> and in
    the log, which is the proof that playback ended cleanly."""
    vt_command("show", PLAYER_VT, status)


SWITCHED_TO_PLAYER_VT = [False]


def exit_to_vt(target, kind, status=""):
    """Leave the viewer on the desktop, never on a console prompt.

    Three rules, in this order: the player only switches back if it still owns
    the screen (a VT change made during playback belongs to whoever made it);
    the target has to exist and differ from the player's VT; and the result is
    verified against /sys/class/tty/tty0/active, then logged as
    `exit, VT 2 (desktop)` or `exit, VT 1 (console)`.

    The status line is written on the player's VT in every case, so a clean
    exit can be proven afterwards even though the viewer never sees it."""
    active = active_vt()
    show_status_line(status)
    if not SWITCHED_TO_PLAYER_VT[0]:
        log("exit: player never took a VT, nothing to restore")
        return active
    player_vt = int(PLAYER_VT) if str(PLAYER_VT).isdigit() else 4
    if active is None or active != player_vt:
        log("exit, VT untouched: user switched to tty%s"
            % (active if active is not None else "?"))
        return active
    if target is None:
        log("exit, VT %d (console, return disabled)" % player_vt)
        return active
    if target == player_vt:
        log("exit, VT %d (console, already there)" % target)
        return active
    if not os.path.exists("/dev/tty%d" % target):
        log("exit: /dev/tty%d missing, staying on tty%d" % (target, player_vt))
        return active
    vt_command("switch", target)
    landed = active_vt()
    if landed == target:
        log("exit, VT %d (%s)" % (target, kind))
    else:
        log("exit, VT %d (%s) not confirmed, active tty%s"
            % (target, kind, landed if landed is not None else "?"))
    return landed


def die(message, code=1):
    log("ERROR:", message)
    if ORIGINAL_VT[0]:
        # Same rule as a normal exit: a fatal error must not leave the viewer
        # on a console prompt either.
        target = return_vt(ORIGINAL_VT[0])
        desktop = session_vt()
        exit_to_vt(target, "desktop" if target is not None and target == desktop
                   else "console", console_text("playback failed: " + message))
    sys.exit(code)


