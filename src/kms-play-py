CUE_RE = re.compile(
    r"(\d+)\s*\n(\d{2}):(\d{2}):(\d{2})[,.](\d{3})\s*-->\s*"
    r"(\d{2}):(\d{2}):(\d{2})[,.](\d{3})")
TAG_RE = re.compile(r"<[^>]+>")


def to_seconds(hours, minutes, seconds, millis):
    return int(hours) * 3600 + int(minutes) * 60 + int(seconds) + int(millis) / 1000.0


def parse_srt(path):
    """Parse an SRT file into a sorted list of (start, end, text).

    Formatting tags are stripped: Pango would render "<i>" literally. Cues are
    sorted because some muxers emit them out of order."""
    text = open(path, "r", encoding="utf-8", errors="replace").read().replace("\r", "")
    cues = []
    for block in re.split(r"\n\s*\n", text):
        match = CUE_RE.search(block)
        if not match:
            continue
        start = to_seconds(match.group(2), match.group(3), match.group(4), match.group(5))
        end = to_seconds(match.group(6), match.group(7), match.group(8), match.group(9))
        body = TAG_RE.sub("", block[match.end():]).strip()
        if body:
            cues.append((start, end, body))
    cues.sort()
    return cues


def extract_srt(media_path, stream_index):
    """Extract one text subtitle stream to a cached .srt file.

    The cache key includes path, size, mtime and stream index, so editing or
    replacing the file invalidates it. Extraction runs ffmpeg synchronously in
    a worker thread (callers use a thread), never on the GLib loop."""
    stat = os.stat(media_path)
    key = hashlib.md5(("%s|%d|%d|%s" % (media_path, stat.st_size,
                                       int(stat.st_mtime), stream_index)).encode()).hexdigest()[:16]
    srt_path = os.path.join(CACHE_DIR, key + ".srt")
    if os.path.exists(srt_path) and os.path.getsize(srt_path) > 0:
        return srt_path
    try:
        subprocess.run(["notify-send", "-t", "4000", "kms-play",
                        tr("osd.preparing_subtitles")], check=False, timeout=3)
    except Exception:
        pass
    tmp_path = srt_path + ".tmp"
    started = monotonic()
    result = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                             "-i", media_path, "-map", "0:%s" % stream_index,
                             "-f", "srt", tmp_path], check=False)
    if result.returncode == 0 and os.path.exists(tmp_path) and os.path.getsize(tmp_path) > 0:
        os.replace(tmp_path, srt_path)
        log("srt extraction for stream %s in %.0f ms" % (stream_index,
                                                         (monotonic() - started) * 1000))
    else:
        log("srt extraction incomplete (code %s)" % result.returncode)
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
    if os.path.exists(srt_path) and os.path.getsize(srt_path) > 0:
        return srt_path
    return None


class Subtitles:
    """Render subtitle cues into the ARGB "sub" plane.

    The surface is a full-width band of fixed height at the bottom of the
    screen, fully transparent except for the glyphs. Only the band is updated,
    so a cue change costs one SetPlane over ~220 rows instead of a full screen.
    """

    def __init__(self, subdaemon, width, screen_height, band_height=220):
        self.subdaemon = subdaemon
        self.width = width
        self.band_height = band_height
        self.y = screen_height - band_height
        self.cues = []
        self.current = None
        self.surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, self.width, self.band_height)
        self.layout = PangoCairo.create_layout(cairo.Context(self.surface))
        # Bold Sans 26 with a 60 px margin is readable at 1080p and 4K.
        self.layout.set_font_description(Pango.FontDescription("Sans Bold 26"))
        self.layout.set_alignment(Pango.Alignment.CENTER)
        self.layout.set_width((self.width - 120) * Pango.SCALE)
        self.layout.set_wrap(Pango.WrapMode.WORD_CHAR)

    def _draw(self, text):
        """Paint one cue: clear the band, draw a black outline, then the text.

        The outline is six offset copies of the same layout (cheap and good
        enough); it keeps subtitles readable over bright scenes without a
        background box. OPERATOR_SOURCE is used only for the clear, so the rest
        of the band keeps real alpha=0."""
        started = monotonic()
        ctx = cairo.Context(self.surface)
        ctx.set_operator(cairo.OPERATOR_SOURCE)
        ctx.set_source_rgba(0, 0, 0, 0)
        ctx.paint()
        ctx.set_operator(cairo.OPERATOR_OVER)
        self.layout.set_text(text, -1)
        x = 60
        y = 8                       # top of the band: leaves room for the OSD
        for dx, dy in ((-3, 0), (3, 0), (0, -3), (0, 3), (3, 3), (-3, -3)):
            ctx.move_to(x + dx, y + dy)
            ctx.set_source_rgba(0, 0, 0, 0.95)
            PangoCairo.show_layout(ctx, self.layout)
        ctx.move_to(x, y)
        ctx.set_source_rgba(1, 1, 1, 1)
        PangoCairo.show_layout(ctx, self.layout)

        self.surface.flush()
        write_surface(RAW_SUB, RAW_SUB_GEOM, self.surface, self.width, self.band_height)
        self.subdaemon.stdin.write("sub cue %d %d %d %d %s\n"
                                   % (0, self.y, self.width, self.band_height, RAW_SUB))
        self.subdaemon.stdin.flush()
        log("cue:", text[:60].replace("\n", " "),
            "| render %.1f ms" % ((monotonic() - started) * 1000))

    def _clear(self):
        self.subdaemon.stdin.write("sub clear\n")
        self.subdaemon.stdin.flush()

    def update(self, position_s):
        """Show the cue covering position_s, or clear the plane.

        Called at 12.5 Hz; the expensive path only runs when the active cue
        actually changes (self.current), so static dialogue costs nothing."""
        if not self.cues:
            return
        active = None
        for start, end, text in self.cues:
            if start <= position_s < end:
                active = text
                break
            if start > position_s:
                break
        if active == self.current:
            return
        self.current = active
        if active:
            self._draw(active)
        else:
            log("clear")
            self._clear()


