# ---------------------------------------------------------------------------
# Seek scale
# ---------------------------------------------------------------------------
# Cumulative scale on successive presses in the SAME direction, as specified:
#   1st press 1 s, 2nd 10 s, 3rd 30 s, 4th 60 s, 5th 120 s,
#   6th and beyond 240 s (clamped to the last entry).
# Each accepted press jumps exactly the current rung, then advances the rung.
# The index returns to the first rung after SEEK_RESET_AFTER without a press,
# or as soon as the direction changes (LEFT after RIGHT).
SEEK_SCALE = (1.0, 10.0, 30.0, 60.0, 120.0, 240.0)

# Minimum delay between two accepted steps. Kernel/hardware repeat can be as
# fast as 30-40 ms; without this, one held key would consume two rungs per
# event pair. 120 ms also means a held arrow advances ~8 rungs/s, which is
# fast but still controllable.
SEEK_DEBOUNCE = 0.120

# Idle time after which the scale restarts at 1 s.
SEEK_RESET_AFTER = 1.0

# An audio track change makes playbin rebuild its audio branch (decoder, resample,
# sink). On this board that reconfiguration can report ERROR, or even EOS, from
# the rendering side. Such a message is not a reason to end the film: within
# this window after a switch it is treated as a failed switch, the previous
# track is restored and playback continues.
AUDIO_SWITCH_GRACE = 3.0

# Self-test hook: pretend a switch failed as soon as it succeeded, to exercise
# recover_audio_switch() against the real pipeline. Never set in normal use.
AUDIO_SWITCH_SELFTEST = os.environ.get("KMS_PLAY_AUDIO_SELFTEST") == "1"

# ---------------------------------------------------------------------------
# Software gain
# ---------------------------------------------------------------------------
# Arrow Up/Down drive the pipeline's "volume" element, i.e. a software gain,
# independent from the PipeWire sink volume used by the multimedia keys.
# It starts saturated at 100 %: the film plays at its own level, the sink
# volume is left to the system keys, and the first Down press is audible
# immediately.
SOFTWARE_GAIN_START = 1.0
SOFTWARE_GAIN_MAX = 1.0
# 2 % per press: 50 presses cover the whole range, which is fine enough for a
# film without making the arrows useless. Override with KMS_PLAY_VOLUME_STEP=1
# for 1 % steps (100 presses).
SOFTWARE_GAIN_STEP = max(1.0, min(25.0, float(os.environ.get("KMS_PLAY_VOLUME_STEP", "2"))))

# Truncate then reopen in append mode: kms-subd also writes to this descriptor
# (stderr), and append avoids NUL holes if the file is truncated mid-flight.
# The previous run is kept as last.log.prev: a crash or a failed track switch
# leaves no other trace, and losing it cost a whole debugging session.
try:
    if os.path.getsize(LOG_PATH) > 0:
        os.replace(LOG_PATH, LOG_PATH + ".prev")
except OSError:
    pass
open(LOG_PATH, "w").close()
log_file = open(LOG_PATH, "a", buffering=1)


def monotonic():
    return time.monotonic()


def log(*args):
    print("[%.3f]" % monotonic(), *args, file=log_file)


# Last resort VT restore: die() can be called before the Player object exists
# (bad arguments, missing file), so the VT number lives at module level.
ORIGINAL_VT = [None]


def vt_command(action, vt):
    """Run kms-vt through the single NOPASSWD rule of /etc/sudoers.d/kms-play.

    Non-interactive only: if sudo would need a password we give up silently
    rather than hang on a prompt nobody can see."""
    return subprocess.run(["sudo", "-n", VT_HELPER, action, str(vt)],
                          capture_output=True, text=True, check=False)


def restore_vt(vt):
    """Leave the console usable: show the cursor again, then switch back."""
    if not vt:
        return
    vt_command("show", PLAYER_VT)
    vt_command("switch", vt)


def die(message, code=1):
    log("ERROR:", message)
    if ORIGINAL_VT[0]:
        restore_vt(ORIGINAL_VT[0])
    sys.exit(code)


# ---------------------------------------------------------------------------
# Keyboard layout
# ---------------------------------------------------------------------------
def configured_layout():
    """XKB layout to use, in order of authority.

    The kernel reports key POSITIONS, not characters: KEY_A is the second key of
    the home row whatever language is configured. On an AZERTY keyboard the key
    labelled A sits at the US Q position and therefore reports KEY_Q — reading
    the US name would make A switch nothing and Q quit the film."""
    candidates = []
    override = os.environ.get("KMS_PLAY_KEYMAP")
    if override:
        candidates.append(override.split(",")[0])
    try:
        with open("/etc/default/keyboard") as handle:
            for line in handle:
                if line.strip().startswith("XKBLAYOUT="):
                    value = line.split("=", 1)[1].strip().strip("\"'")
                    candidates.append(value.split(",")[0])
    except OSError:
        pass
    try:
        out = subprocess.run(["localectl", "status"], capture_output=True,
                             text=True, timeout=2).stdout
        for line in out.splitlines():
            if "X11 Layout" in line:
                candidates.append(line.split(":", 1)[1].strip().split(",")[0])
    except Exception:
        pass
    return next((c for c in candidates if c), "us")


class KeyLayout:
    """Translate an evdev keycode into the character printed on the keycap.

    libxkbcommon is already installed on any system with a Wayland session, so
    this costs no dependency; when it is missing or the keymap cannot be
    compiled, the raw US name is kept (and logged) rather than failing."""

    XKB_KEY_UP, XKB_KEY_DOWN = 0, 1

    def __init__(self, layout=None):
        self.layout = layout or configured_layout()
        self.state = None
        self.lib = None
        try:
            import ctypes

            class RuleNames(ctypes.Structure):
                _fields_ = [("rules", ctypes.c_char_p), ("model", ctypes.c_char_p),
                            ("layout", ctypes.c_char_p), ("variant", ctypes.c_char_p),
                            ("options", ctypes.c_char_p)]

            lib = ctypes.CDLL("libxkbcommon.so.0")
            lib.xkb_context_new.restype = ctypes.c_void_p
            lib.xkb_context_new.argtypes = [ctypes.c_int]
            lib.xkb_keymap_new_from_names.restype = ctypes.c_void_p
            lib.xkb_keymap_new_from_names.argtypes = [
                ctypes.c_void_p, ctypes.POINTER(RuleNames), ctypes.c_int]
            lib.xkb_state_new.restype = ctypes.c_void_p
            lib.xkb_state_new.argtypes = [ctypes.c_void_p]
            lib.xkb_state_update_key.restype = ctypes.c_int
            lib.xkb_state_update_key.argtypes = [ctypes.c_void_p, ctypes.c_uint32,
                                                ctypes.c_int]
            lib.xkb_state_key_get_one_sym.restype = ctypes.c_uint32
            lib.xkb_state_key_get_one_sym.argtypes = [ctypes.c_void_p, ctypes.c_uint32]

            context = lib.xkb_context_new(0)
            names = RuleNames(None, None, self.layout.encode(), None, None)
            keymap = lib.xkb_keymap_new_from_names(context, ctypes.byref(names), 0)
            if not keymap:
                raise RuntimeError("keymap '%s' not found" % self.layout)
            self.state = lib.xkb_state_new(keymap)
            if not self.state:
                raise RuntimeError("cannot allocate xkb state")
            self.lib = lib
            log("keyboard layout:", self.layout)
        except Exception as exc:
            log("keyboard layout unavailable (%s), key positions are used as-is" % exc)
            self.state = None
            self.lib = None

    def token(self, code, name, value):
        """US name -> name for the configured layout, for letter keys only.

        Arrows, space, media keys and ESC are position-independent and are left
        untouched."""
        if self.state is None or self.lib is None or not code:
            return name
        if len(name) != 1 or not name.isalpha():
            return name
        keycode = code + 8            # evdev code + 8 = XKB keycode
        direction = self.XKB_KEY_DOWN if value != 0 else self.XKB_KEY_UP
        try:
            self.lib.xkb_state_update_key(self.state, keycode, direction)
            sym = self.lib.xkb_state_key_get_one_sym(self.state, keycode)
        except Exception:
            return name
        if 0x41 <= sym <= 0x5A:
            return chr(sym)
        if 0x61 <= sym <= 0x7A:
            return chr(sym - 32)
        return name


# Displayed on screen, therefore intentionally French: these are user-facing
# labels, the only place where French is allowed in this project.
LANGUAGE_NAMES = {
    "fre": "Français", "fra": "Français", "eng": "Anglais", "en": "Anglais",
    "spa": "Espagnol", "ger": "Allemand", "deu": "Allemand", "ita": "Italien",
    "jpn": "Japonais", "chi": "Chinois", "zho": "Chinois", "kor": "Coréen",
    "por": "Portugais", "rus": "Russe", "ara": "Arabe", "nld": "Néerlandais",
    "dut": "Néerlandais", "pol": "Polonais", "swe": "Suédois", "dan": "Danois",
    "nor": "Norvégien", "fin": "Finnois", "tur": "Turc", "hin": "Hindi",
    "und": "Indéterminé",
}


def language_name(tags):
    """Return (display name, raw title) for a stream's tags.

    The name is localized for the screen; the title is passed through so the
    caller can build "Français — VFF". Unknown language codes are shown as the
    upper-cased tag rather than being hidden."""
    lang = (tags.get("language") or "").lower()
    title = tags.get("title") or ""
    return LANGUAGE_NAMES.get(lang, lang.upper() if lang else "Inconnu"), title


def short_title(title):
    """Strip the technical bitrate suffix (" @ 640 kbps") from a track title.

    ffprobe often reports titles such as "VFF @ 640 kbps"; the bitrate is
    noise on screen and makes the OSD label longer than the bar."""
    t = re.sub(r"\s*@\s*[\d.,]+\s*kbps\s*$", "", (title or "").strip(), flags=re.I)
    return re.sub(r"\s+", " ", t).strip()


def track_label(name, title):
    """Build the audio label: "Français — VFF" when a distinct title exists."""
    t = short_title(title)
    if t and t.lower() != name.lower():
        return "%s — %s" % (name, t)
    return name


def hms(seconds):
    """Format a duration as m:ss or h:mm:ss."""
    seconds = max(0, int(seconds))
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return "%d:%02d:%02d" % (hours, minutes, secs)
    return "%d:%02d" % (minutes, secs)


def format_step(delta):
    """Format a seek step with its sign, French decimal comma on screen.

    The sign matters: "−0,5 s" and "+0,5 s" are different actions and the OSD
    is the only feedback the user gets."""
    sign = "+" if delta >= 0 else "−"
    value = abs(delta)
    if value >= 1.0:
        return "%s%d s" % (sign, int(value))
    return ("%s%.1f s" % (sign, value)).replace(".", ",")


