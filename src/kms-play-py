def probe_media(path):
    """List audio and text subtitle streams of the container.

    Only text codecs are kept: image-based subtitles (PGS/DVD) cannot be
    rendered by Pango and would need a bitmap path we do not implement.
    Returns (audio_streams, subtitle_streams, video_stream), the last one being
    the first video stream (or {}) used as a fallback by the startup banner
    when the negotiated caps do not carry every field."""
    proc = subprocess.run(["ffprobe", "-v", "error", "-show_entries",
                           "stream=index,codec_type,codec_name,profile,width,height,"
                           "r_frame_rate:stream_tags=language,title",
                           "-of", "json", path], capture_output=True, text=True)
    try:
        streams = json.loads(proc.stdout or "{}").get("streams", [])
    except Exception as exc:
        log("ffprobe output unreadable:", exc)
        return [], [], {}
    audio, subs, video = [], [], {}
    for stream in streams:
        if stream.get("codec_type") == "audio":
            audio.append(stream)
        elif stream.get("codec_type") == "subtitle" and stream.get("codec_name") in (
                "subrip", "ass", "ssa", "mov_text", "webvtt"):
            subs.append(stream)
        elif stream.get("codec_type") == "video" and not video:
            video = stream
    return audio, subs, video


def write_surface(raw_path, geom_path, surface, width, height):
    """Write an overlay buffer and its geometry side by side.

    The raw file holds the pixels, the geom file says how wide and high they
    are: the OSD surface changes shape between the bottom band and the startup
    banner, and kms-shot reads the buffer back without any other context. The
    geometry is replaced atomically (tmp + rename) so a capture running at the
    same time never sees half a size."""
    with open(raw_path, "wb") as handle:
        handle.write(bytes(surface.get_data()))
    tmp = geom_path + ".tmp"
    with open(tmp, "w") as handle:
        handle.write("%dx%d\n" % (width, height))
    os.replace(tmp, geom_path)


def display_info():
    """Connector name, active mode and refresh rate, from kms-planes.

    Read once at startup. /sys/class/drm/*/modes only lists the modes a
    connector accepts, never which one is being scanned out, and says nothing
    about the vertical refresh: only the kernel's CRTC state knows both, which
    is what kms-planes prints. A connector whose CRTC is not routed yet shows
    its preferred mode, flagged as such, instead of pretending it is live."""
    info = {"name": None, "width": 0, "height": 0, "vrefresh": 0}
    try:
        out = subprocess.run([PLANES_TOOL], capture_output=True, text=True,
                             timeout=5, env=CHILD_ENV).stdout
    except Exception as exc:
        log("display info: kms-planes failed:", exc)
        return info
    for line in out.splitlines():
        match = re.match(r"connector (\S+) connected crtc=\d+ mode=(\d+)x(\d+) "
                         r"vrefresh=(\d+)", line)
        if not match:
            continue
        candidate = {"name": match.group(1), "width": int(match.group(2)),
                     "height": int(match.group(3)), "vrefresh": int(match.group(4))}
        if "preferred" not in line:
            return candidate           # live CRTC mode: authoritative
        if info["name"] is None:
            info = candidate           # keep as a fallback, keep looking
    return info


def planes_in_use():
    """Ids of the DRM planes that still scan out a framebuffer.

    Read back from kms-planes --short rather than assumed from the teardown:
    fb=0 with position 0+0 is the kernel's way of saying "this plane is off",
    and that is what the exit path has to achieve on all three planes."""
    try:
        out = subprocess.run([PLANES_TOOL, "--short"], capture_output=True,
                             text=True, timeout=5, env=CHILD_ENV).stdout
    except Exception:
        return []
    busy = []
    for line in out.splitlines():
        match = re.match(r"plane (\d+) .*fb=(\d+) .*pos=\+(\d+)\+(\d+)", line)
        if not match:
            continue
        if match.group(2) != "0" or match.group(3) != "0" or match.group(4) != "0":
            busy.append(int(match.group(1)))
    return busy


def console_text(text, limit=120):
    """Flatten a string for the VT: no control characters, no newlines.

    The file name reaches the console through the root helper, so it is
    stripped of anything that could act as an escape sequence and bounded in
    length rather than trusted."""
    text = re.sub(r"[\x00-\x1f\x7f]+", " ", text or "")
    text = re.sub(r"\s+", " ", text).strip()
    return text[:limit]


def plane_state(plane_id):
    """fmt/zpos/fb/geometry of one plane right now, from kms-planes --short.

    Called when the banner is about to be drawn, not at startup: before the
    first frame the plane has no framebuffer (fmt "-"). Once the decoder is
    feeding it, fmt is the DRM fourcc of the buffer actually scanned out, and
    that is the value the banner must show (NV15 for 10-bit HEVC, even though
    the GStreamer caps call it DMA_DRM or P010_10LE)."""
    try:
        out = subprocess.run([PLANES_TOOL, "--short"], capture_output=True, text=True,
                             timeout=5, env=CHILD_ENV).stdout
    except Exception:
        return {}
    for line in out.splitlines():
        match = re.search(r"plane %d zpos=(\d+) fb=(\d+) fmt=(\S+)"
                          r"(?:.* pos=\+(\d+)\+(\d+) frame=(\d+)x(\d+))?" % plane_id,
                          line)
        if match:
            state = {"zpos": int(match.group(1)), "fb": int(match.group(2)),
                     "fmt": match.group(3)}
            if match.group(4) is not None:
                state.update({
                    "x": int(match.group(4)), "y": int(match.group(5)),
                    "frame_width": int(match.group(6)),
                    "frame_height": int(match.group(7)),
                })
            return state
    return {}


CODEC_LABELS = {
    "video/x-h265": "H.265", "video/x-h264": "H.264", "video/x-vp8": "VP8",
    "video/x-vp9": "VP9", "video/x-av1": "AV1", "video/x-mpeg2": "MPEG-2",
    "video/x-mpeg4": "MPEG-4", "video/x-theora": "Theora",
    "hevc": "H.265", "h264": "H.264", "vp8": "VP8", "vp9": "VP9",
    "av1": "AV1", "mpeg2video": "MPEG-2", "mpeg4": "MPEG-4",
}


def codec_label(name):
    """Turn a caps structure name or an ffprobe codec_name into H.265 etc."""
    if not name:
        return ""
    return CODEC_LABELS.get(name, name.replace("video/x-", ""))


def profile_label(profile):
    """'main-10' -> 'Main 10', 'high' -> 'High'."""
    if not profile:
        return ""
    return " ".join(part.capitalize() for part in re.split(r"[-_ ]+", profile) if part)


def framerate_label(text):
    """'24000/1001' -> '23.976 fps', '25/1' -> '25 fps'."""
    try:
        if "/" in str(text):
            num, den = str(text).split("/")[:2]
            rate = float(num) / float(den)
        else:
            rate = float(text)
    except (TypeError, ValueError, ZeroDivisionError):
        return ""
    if rate <= 0:
        return ""
    if abs(rate - round(rate)) < 0.01:
        return "%d fps" % round(rate)
    return "%.3f fps" % rate


def screen_size():
    """Scanout resolution, taken from the connector's preferred mode.

    kmssink picks the preferred mode too, so this matches what the VOP will
    actually display. Falls back to 1920x1080 if no HDMI modes file is found
    (headless testing)."""
    import glob
    for path in sorted(glob.glob("/sys/class/drm/card*-HDMI-A-*/modes")):
        try:
            with open(path) as handle:
                mode = handle.readline().strip()
        except OSError:
            continue
        if "x" in mode:
            width, height = mode.split("x")[:2]
            return int(width), int(height)
    return 1920, 1080


def select_planes():
    """Ask kms-planes --select for the three planes and their CRTC.

    This is the only place where planes are chosen. kms-planes owns the
    algorithm (plane-select.h), so the video plane given to kmssink, the two
    planes given to kms-subd and the ids printed by a manual `kms-planes
    --select` are always the same answer. It also means a plan belonging to
    another CRTC can never be programmed: only the planes of the CRTC routed
    by the chosen connector are candidates.

    Returns {"video": {...} or None, "sub": ..., "osd": ..., "crtc": int}.
    The video entry is mandatory; sub/osd may be None when the board cannot
    provide them (degraded operation, logged by kms-planes)."""
    result = {"video": None, "sub": None, "osd": None, "crtc": 0}
    try:
        proc = subprocess.run([PLANES_TOOL, "--select"], capture_output=True,
                              text=True, timeout=5, env=CHILD_ENV)
    except Exception as exc:
        log("plane selection: cannot run kms-planes --select:", exc)
        return result
    detail = (proc.stderr or "").strip()
    if detail:
        log("plane selection:", detail.replace("\n", " | "))
    if proc.returncode != 0:
        return result
    for line in proc.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        role = fields[0]
        if role not in ("video", "sub", "osd"):
            continue
        if len(fields) < 2:
            continue
        if fields[1] == "none":
            result[role] = None
            continue
        if len(fields) < 5:
            continue
        result[role] = {"id": int(fields[1]), "crtc": int(fields[2]),
                        "fourcc": fields[3], "zpos": int(fields[4])}
        if role == "video":
            result["crtc"] = int(fields[2])
    return result


def video_candidate_ids():
    """Video plane candidates, best first, for the single retry.

    Same selection code (`kms-planes --list-video`): overlay planes of the
    routed CRTC that accept NV15/NV12, ordered exactly like --select."""
    try:
        out = subprocess.run([PLANES_TOOL, "--list-video"], capture_output=True,
                             text=True, timeout=5, env=CHILD_ENV).stdout
    except Exception:
        return []
    return [int(line) for line in out.splitlines() if line.strip().isdigit()]


