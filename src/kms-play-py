class Player:
    def __init__(self, media_path):
        self.media_path = media_path
        self.width, self.height = screen_size()
        log("screen:", self.width, "x", self.height)

        # Connector name, live mode and refresh rate, read once: the banner
        # must report what the VOP scans out, not what the file claims.
        self.display = display_info()
        log("display:", self.display.get("name"),
            "%dx%d" % (self.display.get("width") or 0, self.display.get("height") or 0),
            "vrefresh=%s" % self.display.get("vrefresh"))

        self.audio, self.subs, self.probe_video = probe_media(media_path)
        log("audio streams:", [(s["index"], language_name(s.get("tags") or {})[0])
                               for s in self.audio])
        log("subtitle streams:", [(s["index"], (s.get("tags") or {}).get("title", ""),
                                   (s.get("tags") or {}).get("language", ""))
                                  for s in self.subs])

        # One selection for the whole player. kms-planes decides which plane
        # of which CRTC is the video plane and which two overlays carry text;
        # the same ids are handed to kmssink and to kms-subd below.
        self.planes = select_planes()
        if not self.planes["video"]:
            die("no NV15/NV12 video plane on the connected display "
                "(run kms-planes --check)")
        self.video_plane = self.planes["video"]["id"]
        self.video_crtc = self.planes["crtc"]
        log("planes: video %d (%s zpos %d) | sub %s | osd %s | crtc %d"
            % (self.video_plane, self.planes["video"]["fourcc"],
               self.planes["video"]["zpos"],
               self.planes["sub"]["id"] if self.planes["sub"] else "none",
               self.planes["osd"]["id"] if self.planes["osd"] else "none",
               self.video_crtc))
        if not self.planes["sub"]:
            log("planes: no subtitle plane available, subtitles disabled")
        if not self.planes["osd"]:
            log("planes: no OSD plane available, on-screen display disabled")
        # Post-configuration verification state (see _verify_video_plane).
        self.plane_attempts = 0
        self.plane_verified = False
        self.plane_check_scheduled = False

        # Default subtitle track: the first one whose title does not contain
        # "forced" (forced tracks only carry signs and foreign dialogue).
        self.sub_index = 0
        for index, stream in enumerate(self.subs):
            title = ((stream.get("tags") or {}).get("title") or "").lower()
            if "forced" not in title:
                self.sub_index = index
                break
        self.subtitles_enabled = bool(self.subs) and self.planes["sub"] is not None

        self.subdaemon = None
        self.subtitles = None
        self.osd = None
        self.pipeline = None
        # Decode tier state: 1 = playbin's own choice (hardware when possible),
        # 2 = forced software decoders. fallback_done makes the fallback
        # single-shot: a second failure stops cleanly instead of looping.
        self.tier = 1
        self.fallback_done = False
        self.tier_logged = False
        self.video_caps_seen = False
        self.play_requested_at = 0.0
        # Negotiated video description, filled by _on_video_caps and used by
        # the startup banner. Width/height/framerate come from the raw caps;
        # codec and profile from the decoder's input caps.
        self.video_format = ""
        self.video_drm_format = ""
        self.video_memory = ""
        self.video_width = 0
        self.video_height = 0
        self.video_framerate = ""
        self.codec_name = ""
        self.codec_profile = ""
        self.startup_panel_shown = False
        self.main_loop = GLib.MainLoop()
        self.finished = False
        # Exit bookkeeping: why playback ended (for the console line) and
        # whether the planes were confirmed off (see _release_planes).
        self.stop_reason = "requested"
        self.planes_released = False
        self.inhibit_cookie = None
        self.previous_vt = None
        # VT resolved at startup (see switch_vt) and its label for the log.
        self.return_vt = None
        self.return_kind = "console"
        self.gain = SOFTWARE_GAIN_START
        self.volume_element = None
        self.duration = None
        self.target_position = 0.0
        self.target_set_at = 0.0
        self.paused = False

        # Seek scale state. seek_direction is 0 while no arrow has been used.
        self.seek_direction = 0
        self.seek_index = 0
        self.seek_last_at = 0.0

        # Audio switch bookkeeping (see next_audio / recover_audio_switch).
        self.audio_switch_at = 0.0
        self.audio_previous = None
        self.audio_recoveries = 0
        self.keylayout = KeyLayout()
        self.keyboard = None

    # -- infrastructure ----------------------------------------------------

    def switch_vt(self):
        """Move to the player's VT, cleared, before anyone calls drmSetMaster.

        The VT that owns the console holds the DRM master; without switching
        away, drmSetMaster returns EACCES. The previous VT is remembered so it
        can be restored on exit.

        The target is always PLAYER_VT, never a VT that carries a getty: a
        login prompt left behind by systemd-logind is drawn on the console
        framebuffer, and the video plane only covers the picture. In the
        letterbox it showed up above and below the film. kms-vt (the only
        sudo command allowed here, see /etc/sudoers.d/kms-play) switches,
        clears the screen and hides the cursor in one call."""
        active = active_vt()
        self.previous_vt = str(active) if active else "1"
        ORIGINAL_VT[0] = self.previous_vt
        # Resolved here, at startup, not at exit: this is the state the viewer
        # left behind, and logind could answer differently once the player owns
        # the console. The label says what the target actually is, which
        # matters when KMS_PLAY_RETURN_VT pins a VT.
        self.return_vt = return_vt(self.previous_vt)
        desktop = session_vt()
        self.return_kind = "desktop" if self.return_vt is not None \
            and self.return_vt == desktop else "console"
        log("VT: previous tty%s, returning to %s (%s)"
            % (self.previous_vt, self.return_vt if self.return_vt is not None
               else "none", self.return_kind))
        result = vt_command("prepare", PLAYER_VT)
        if result.returncode != 0:
            log("kms-vt prepare failed:", (result.stderr or "").strip(),
                "- is the sudoers rule installed?")
        for _ in range(25):
            if open(ACTIVE_VT_PATH).read().strip() == "tty" + PLAYER_VT:
                break
            time.sleep(0.2)
        time.sleep(0.3)
        # From here the player owns the console, so the exit path may switch it
        # back (exit_to_vt refuses to if the user moved to another VT).
        SWITCHED_TO_PLAYER_VT[0] = True
        log("active VT:", open("/sys/class/tty/tty0/active").read().strip())

    def start_subdaemon(self):
        """Start kms-subd and wait for its socket.

        Any leftover daemon of the same user is killed first: it may still hold
        the DRM master from a previous crash, which would block this one."""
        subprocess.run(["pkill", "-9", "-x", "kms-subd"], check=False)
        try:
            os.unlink(SOCK_PATH)
        except OSError:
            pass
        # The three ids and the CRTC come from the single selection above, so
        # the daemon cannot pick a different (or another CRTC's) plane.
        self.subdaemon = subprocess.Popen(
            [SUBDAEMON, SOCK_PATH, str(self.video_plane),
             str(self.planes["sub"]["id"]) if self.planes["sub"] else "none",
             str(self.planes["osd"]["id"]) if self.planes["osd"] else "none",
             str(self.video_crtc)],
            stdin=subprocess.PIPE, stderr=log_file, text=True,
            env=CHILD_ENV, bufsize=1)
        for _ in range(100):
            if os.path.exists(SOCK_PATH):
                break
            time.sleep(0.05)
        if not os.path.exists(SOCK_PATH):
            die("kms-subd did not start")
        self.subtitles = Subtitles(self.subdaemon, self.width, self.height)
        self.osd = OnScreenDisplay(self.subdaemon, self.width, self.height)

    def inhibit_session(self):
        """Ask GNOME to inhibit suspend/idle for the duration of the film.

        Purely best effort: the player works without a session bus. The cookie
        must be released in release_inhibit(), otherwise the inhibition would
        leak until logout."""
        try:
            from gi.repository import Gio
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            result = bus.call_sync("org.gnome.SessionManager", "/org/gnome/SessionManager",
                                   "org.gnome.SessionManager", "Inhibit",
                                   GLib.Variant("(susu)", ("kms-play", 0, "lecture video", 12)),
                                   GLib.VariantType.new("(u)"), Gio.DBusCallFlags.NONE, 2000, None)
            self.inhibit_cookie = result.unpack()[0]
            log("session inhibition set, cookie:", self.inhibit_cookie)
        except Exception as exc:
            log("no GNOME session inhibition:", exc)

    def release_inhibit(self):
        if not self.inhibit_cookie:
            return
        try:
            from gi.repository import Gio
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            bus.call_sync("org.gnome.SessionManager", "/org/gnome/SessionManager",
                          "org.gnome.SessionManager", "Uninhibit",
                          GLib.Variant("(u)", (self.inhibit_cookie,)), None,
                          Gio.DBusCallFlags.NONE, 2000, None)
        except Exception:
            pass

    # -- pipeline ----------------------------------------------------------

    def build_pipeline(self, software=False):
        """Build playbin with kmssink on the video plane and a gain element.

        flags: VIDEO | AUDIO only. TEXT is deliberately cleared because
        playbin would try to render subtitles itself through a text sink; this
        player draws them on its own plane instead.

        audio-sink: the "volume" element exposes a software gain (0..10 in
        GStreamer units) in front of the real sink; we drive it 0..1.

        software=False is tier 1, unchanged: playbin -> kmssink, and the
        decoder's DMABufs go to the plane untouched.
        software=True is tier 2: uridecodebin is told force-sw-decoders and a
        videoconvert bridges the system-memory frames to kmssink. Slower, but
        it plays every codec GStreamer can decode."""
        pipeline = Gst.ElementFactory.make("playbin", "player")
        if not pipeline:
            die("playbin unavailable")
        pipeline.set_property("uri", Gst.filename_to_uri(self.media_path))
        # GST_PLAY_FLAG_VIDEO = 1, GST_PLAY_FLAG_AUDIO = 2, GST_PLAY_FLAG_TEXT = 4,
        # GST_PLAY_FLAG_FORCE_SW_DECODERS = 0x1000.
        flags = 0x1 | 0x2
        if software:
            # Tier 2 has three defences, because auto-plugging is stubborn:
            # the playbin flag, the uridecodebin property, and a rank demotion
            # of every hardware decoder (see _demote_hardware_decoders).
            flags |= 0x1000
            self._demote_hardware_decoders()
        pipeline.set_property("flags", flags)
        if software:
            # playbin owns its uridecodebin child: the child-added hook is the
            # only point where the property is set before the decoder is
            # chosen (decodebin reads it while auto-plugging).
            pipeline.connect("child-added", self._force_software_decoders)
            video_description = ("videoconvert ! kmssink plane-id=%d restore-crtc=true"
                                 % self.video_plane)
        else:
            # restore-crtc is true by default; it is set explicitly because it
            # is the sink side of the exit path, and a version changing that
            # default would silently reintroduce the black screen. It restores
            # the CRTC mode when going to NULL, which is not enough on its own:
            # the plane stays programmed, hence the explicit release below.
            video_description = ("kmssink plane-id=%d restore-crtc=true"
                                 % self.video_plane)
        video_sink = Gst.parse_bin_from_description(video_description, True)
        pipeline.set_property("video-sink", video_sink)
        audio_description = "volume name=gain ! audioconvert ! audioresample ! autoaudiosink"
        audio_bin = Gst.parse_bin_from_description(audio_description, True)
        pipeline.set_property("audio-sink", audio_bin)
        self.volume_element = audio_bin.get_by_name("gain")
        self.volume_element.set_property("volume", self.gain)
        log("software gain at start: %d %%" % round(self.gain * 100))

        # Caps probes: this is the only reliable proof that the decoder output
        # reaches the sink as DMABuf memory (zero copy) and in which format.
        # In tier 2 the bin's own sink pad is videoconvert's, i.e. the frames
        # as the software decoder produced them, in system memory.
        pad = video_sink.get_static_pad("sink")
        pad.add_probe(Gst.PadProbeType.EVENT_DOWNSTREAM, self._on_video_caps)
        audio_pad = audio_bin.get_static_pad("sink")
        audio_pad.add_probe(Gst.PadProbeType.EVENT_DOWNSTREAM, self._on_audio_caps)

        log("pipeline: playbin uri=%s flags=video+audio video-sink='%s' audio=%s"
            % (self.media_path, video_description, audio_description))
        self.pipeline = pipeline

    def _demote_hardware_decoders(self):
        """Drop every Hardware decoder to rank NONE for the software tier.

        force-sw-decoders is set on uridecodebin too, but playbin creates its
        decodebin before that property can propagate, so on this GStreamer the
        hardware decoder was still picked. Rank is what auto-plugging really
        obeys; the change lives in this process only."""
        demoted = []
        registry = Gst.Registry.get()
        for factory in registry.get_feature_list(Gst.ElementFactory):
            klass = factory.get_metadata(Gst.ELEMENT_METADATA_KLASS) or ""
            if "Decoder" in klass and "Hardware" in klass:
                demoted.append("%s(%d)" % (factory.get_name(), factory.get_rank()))
                factory.set_rank(Gst.Rank.NONE)
        log("software tier: hardware decoders demoted:", ", ".join(demoted) or "none")

    def _force_software_decoders(self, _proxy, obj, name=None):
        """child-added hook: force software decoding inside uridecodebin.

        GStreamer 1.24 passes the child name as a third argument; older
        versions pass two, hence the optional parameter."""
        factory = obj.get_factory()
        factory_name = factory.get_name() if factory else ""
        if factory_name.startswith("uridecodebin"):
            try:
                obj.set_property("force-sw-decoders", True)
                log("software tier: force-sw-decoders on", obj.get_name())
            except Exception as exc:
                log("software tier: cannot force software decoders:", exc)

    def _on_video_caps(self, pad, info):
        event = info.get_event()
        if event.type == Gst.EventType.CAPS:
            caps = event.parse_caps()
            if caps and caps.get_size():
                structure = caps.get_structure(0)
                fmt = structure.get_value("format") if structure.has_field("format") else "?"
                caps_text = caps.to_string()
                memory = "DMABuf" if "memory:DMABuf" in caps_text else "system"
                self._record_video_caps(structure, str(fmt), memory, caps_text)
                if getattr(self, "_last_video_caps", None) != (fmt, memory):
                    self._last_video_caps = (fmt, memory)
                    self.video_caps_seen = True
                    log("video caps:", structure.get_name(), "format=" + str(fmt),
                        "memory=" + memory,
                        "size=%sx%s" % (self.video_width, self.video_height),
                        "fps=" + (self.video_framerate or "?"))
                    if not self.tier_logged:
                        self.tier_logged = True
                        if self.tier == 1 and memory == "DMABuf":
                            log("decode tier: hardware (zero copy, %s -> kmssink)"
                                % str(fmt))
                        elif self.tier == 1:
                            # playbin already picked a software decoder by
                            # itself (no usable hardware decoder for this
                            # codec); the frames travel through system memory.
                            log("decode tier: software (reason: no hardware decoder "
                                "selected, system memory)")
                        else:
                            log("decode tier: software (confirmed, %s in system memory)"
                                % str(fmt))
                    # One startup panel per playback, drawn from the main
                    # loop: the probe runs on the streaming thread and the
                    # panel writes to the DRM plane through kms-subd's stdin.
                    # The plane is verified shortly after the first frames:
                    # fb!=0 and full-screen coverage are the only proof that
                    # kmssink really took the plane we selected.
                    if not self.plane_check_scheduled:
                        self.plane_check_scheduled = True
                        GLib.timeout_add(1500, self._verify_video_plane)
                    if not self.startup_panel_shown:
                        self.startup_panel_shown = True
                        GLib.idle_add(self._show_startup_panel)
        return Gst.PadProbeReturn.OK

    def _kmssink(self):
        """The kmssink element, wherever playbin put it."""
        if not self.pipeline:
            return None
        iterator = self.pipeline.iterate()
        while True:
            result, elem = iterator.next()
            if result == Gst.IteratorResult.DONE:
                return None
            if result != Gst.IteratorResult.OK:
                continue
            factory = elem.get_factory()
            if factory and factory.get_name() == "kmssink":
                return elem

    def _verify_video_plane(self):
        """Read back the video plane once the first frames are on screen.

        fb!=0 and a size covering the screen are the proof that kmssink took
        the plane this player selected. On failure the next kms-planes
        --list-video candidate is tried exactly once (two attempts total), and
        a second failure is logged instead of looping."""
        if self.plane_verified:
            return False
        state = plane_state(self.video_plane)
        fb = state.get("fb", 0)
        fw = state.get("frame_width", 0)
        fh = state.get("frame_height", 0)
        # Coverage itself cannot be read back here: this Rockchip driver does
        # not expose the atomic CRTC_W/CRTC_H plane properties, and the legacy
        # GETPLANE ioctl carries no plane size. fb!=0 proves kmssink took the
        # plane; kmssink programmes it over the whole CRTC by construction.
        if fb and fw and fh:
            self.plane_verified = True
            log("plane verify: video %d fb=%d frame=%dx%d at +%d+%d, screen %dx%d"
                % (self.video_plane, fb, fw, fh, state.get("x", 0),
                   state.get("y", 0), self.width, self.height))
            if state.get("zpos") != self.planes["video"]["zpos"]:
                # zpos is read, never forced: an immutable property (or a
                # driver reordering) shows up here as a different value.
                log("plane verify: zpos read back %s, selected %s"
                    % (state.get("zpos"), self.planes["video"]["zpos"]))
            return False
        self.plane_attempts += 1
        log("plane verify: video %d NOT scanning out (fb=%d frame=%dx%d, "
            "screen %dx%d)"
            % (self.video_plane, fb, fw, fh, self.width, self.height))
        if self.plane_attempts >= 2:
            log("plane verify: giving up after 2 attempts, video may be black")
            self.plane_verified = True
            return False
        if os.environ.get("KMS_PLAY_PLANES"):
            log("plane verify: plane override in use, not retrying another plane")
            self.plane_verified = True
            return False
        candidates = [pid for pid in video_candidate_ids()
                      if pid != self.video_plane]
        sink = self._kmssink()
        if not candidates or not sink:
            log("plane verify: no alternate video plane available")
            self.plane_verified = True
            return False
        self.video_plane = candidates[0]
        log("plane verify: retrying with video plane", self.video_plane)
        try:
            sink.set_property("plane-id", self.video_plane)
            if self.subdaemon:
                # kms-subd must release the new plane on exit, not the old one.
                self.subdaemon.stdin.write("video %d\n" % self.video_plane)
                self.subdaemon.stdin.flush()
        except Exception as exc:
            log("plane verify: retry failed:", exc)
            self.plane_verified = True
            return False
        GLib.timeout_add(1500, self._verify_video_plane)
        return False

    def _record_video_caps(self, structure, fmt, memory, caps_text=""):
        """Keep the negotiated description for the banner.

        Width, height and framerate are taken from the raw caps (the ones that
        reached the sink), which is exactly what the VOP will scan out. The
        codec and its profile are not in those caps (they describe raw video),
        so they are read from the decoder's input caps and falling back to what
        ffprobe said about the file if the decoder cannot be located."""
        self.video_format = fmt
        self.video_memory = memory
        for attr, field in (("video_width", "width"), ("video_height", "height")):
            if structure.has_field(field):
                try:
                    setattr(self, attr, int(structure.get_value(field)))
                except (TypeError, ValueError):
                    pass
        # GstFraction has no pygobject conversion, so get_value("framerate")
        # raises TypeError. The caps string always carries it as a fraction.
        match = re.search(r"framerate=\(fraction\)\s*(\d+/\d+)", caps_text)
        if match:
            self.video_framerate = match.group(1)
        # 10-bit video is negotiated as DMA_DRM, but the caps also carry the
        # concrete fourcc the VOP will read (NV15). Handy when kms-planes
        # cannot be read at that instant.
        match = re.search(r"drm-format=\(string\)(\S+?)[,\s]", caps_text)
        if match:
            self.video_drm_format = match.group(1)
        if not self.codec_name:
            name, profile = self._negotiated_codec()
            if name:
                self.codec_name, self.codec_profile = name, profile
                log("codec: %s profile=%s (decoder input caps)"
                    % (name, profile or "?"))
            else:
                probe = self.probe_video or {}
                self.codec_name = probe.get("codec_name") or ""
                self.codec_profile = probe.get("profile") or ""
                log("codec: %s profile=%s (ffprobe fallback)"
                    % (self.codec_name or "?", self.codec_profile or "?"))

    def _negotiated_codec(self):
        """Codec and profile from the decoder's sink caps, or ("", "").

        The caps at the video sink are raw video: they cannot name H.265 or its
        profile. The compressed caps live on the parser/decoder sink pads, so
        the pipeline tree is scanned once for an element whose sink caps are
        video/x-<codec> but not raw. The decoder is preferred implicitly by
        being listed before its parser; a structure carrying `profile` wins
        because that is the value the banner shows."""
        codec, profile = "", ""
        try:
            iterator = self.pipeline.iterate_recurse()
        except Exception:
            return codec, profile
        while True:
            try:
                result, element = iterator.next()
            except Exception:
                break
            if result != Gst.IteratorResult.OK:
                break
            if not isinstance(element, Gst.Element):
                continue
            sink = element.get_static_pad("sink")
            if sink is None:
                continue
            caps = sink.get_current_caps()
            if caps is None or not caps.get_size():
                continue
            structure = caps.get_structure(0)
            name = structure.get_name()
            if not name.startswith("video/x-") or name.startswith("video/x-raw"):
                continue
            if not codec:
                codec = name
            if structure.has_field("profile"):
                return name, str(structure.get_value("profile"))
        return codec, profile

    def _on_audio_caps(self, pad, info):
        event = info.get_event()
        if event.type == Gst.EventType.CAPS:
            caps = event.parse_caps()
            if caps and caps.get_size():
                structure = caps.get_structure(0)
                log("audio caps:", structure.get_name(),
                    "rate=" + str(structure.get_value("rate")
                                  if structure.has_field("rate") else "?"))
        return Gst.PadProbeReturn.OK

    # -- information panel -------------------------------------------------

    def _panel_base_lines(self):
        """The four panel lines, from the values just negotiated.

        This method only resolves facts; the text itself comes from
        format_panel_lines(), which is where the labels are localized and the
        technical values isolated for RTL. Keeping the split means the test
        script renders the same composition the player does.

        Every value has a single source, so the panel can be trusted as a
        report and not as a guess:
          line 1  decode tier     -> the tier the caps probe confirmed;
          line 2  codec/profile   -> decoder input caps, size/rate -> raw caps;
          line 3  plane fmt/zpos  -> kms-planes, i.e. the kernel's plane state;
          line 4  screen          -> kms-planes connector + live CRTC mode.
        Missing fields are omitted rather than printed as "None"."""
        probe = self.probe_video or {}
        width = self.video_width or probe.get("width") or 0
        height = self.video_height or probe.get("height") or 0

        state = plane_state(self.video_plane)
        plane_fmt = state.get("fmt") if state else None
        if not plane_fmt or plane_fmt == "-":
            # No framebuffer yet (or unreadable): the caps' drm-format is the
            # concrete fourcc negotiated with the decoder, so it is used next.
            plane_fmt = self.video_drm_format or self.video_format or "?"

        return format_panel_lines({
            "hardware": self.tier == 1 and self.video_memory == "DMABuf",
            "codec": codec_label(self.codec_name or probe.get("codec_name")),
            "profile": profile_label(self.codec_profile or probe.get("profile")),
            "definition": ("%dx%d" % (width, height)) if width and height else "",
            "rate": framerate_label(self.video_framerate or probe.get("r_frame_rate")),
            "plane": self.video_plane,
            "fmt": plane_fmt,
            # The plane scans out what kmssink accepted; the decoder output can
            # be a different fourcc (I420 through videoconvert becomes NV12).
            # Show both when they differ; skip DMA_DRM, which only says "a DRM
            # buffer" and is not a layout.
            "caps_fmt": self.video_format or "",
            "dmabuf": self.video_memory == "DMABuf",
            "zpos": state.get("zpos") if state else None,
            "connector": self.display.get("name"),
            "width": self.display.get("width") or self.width,
            "height": self.display.get("height") or self.height,
            "vrefresh": self.display.get("vrefresh"),
        })

    def _panel_lines(self):
        """The startup lines plus the file being played, for the I key.

        Base name only: the directory adds nothing and can be very long. The
        renderer shortens the name in the middle if it does not fit, keeping
        the extension and the release tag at the end."""
        return self._panel_base_lines() + [os.path.basename(self.media_path)]

    def _show_startup_panel(self):
        """idle_add target: draw the startup panel once the main loop is free."""
        if self.finished or self.osd is None:
            return False
        self.osd.show_panel(self._panel_base_lines(), kind="startup")
        return False

    def toggle_info_panel(self):
        """Key I: show the panel with the file name, or hide it if it is up.

        Only I closes it: the panel is meant to be read while seeking, so the
        other keys leave it alone (and the bottom band stays suppressed)."""
        if self.osd.panel_visible and self.osd.panel_kind == "manual":
            self.osd.hide_panel("key I")
            return
        self.osd.show_panel(self._panel_lines(), kind="manual")

    # -- decode tier fallback ---------------------------------------------

    def _attach_bus(self, pipeline):
        bus = pipeline.get_bus()
        bus.add_signal_watch()
        bus.connect("message", self.on_message)

    def degrade_to_software(self, reason):
        """Tier 1 failed: replay the file with software decoders.

        Single shot by construction (fallback_done). The new playbin restarts
        at the position the failed pipeline had reached, so a negotiation
        error two seconds in does not send the viewer back to the menu.
        Nothing here loops: a second failure ends playback with a clear OSD
        message and a 'decode tier: none' line in the log."""
        if self.finished:
            return
        if self.fallback_done:
            log("decode tier: none (software fallback failed)")
            if self.osd:
                self.osd.show(label=tr("osd.playback_failed"), right="", duration=5)
            self.stop("error")
            return
        self.fallback_done = True
        self.tier = 2
        # The panel describes the tier that is negotiating caps. After a
        # fallback it would announce the wrong one, so it is dropped and drawn
        # again from the new caps (the software tier is worth reporting).
        if self.osd is not None:
            self.osd.cancel_panel("decode tier change")
        self.startup_panel_shown = False
        position = 0.0
        try:
            position = max(0.0, self.position())
        except Exception:
            pass
        log("decode tier: software (reason: %s)" % reason)
        log("fallback: rebuilding playbin with software decoders at %s"
            % hms(position))

        old = self.pipeline
        if old is not None:
            try:
                bus = old.get_bus()
                if bus:
                    bus.remove_signal_watch()
            except Exception:
                pass
            try:
                old.set_state(Gst.State.NULL)
            except Exception:
                pass
        self.pipeline = None
        self.volume_element = None
        self._last_video_caps = None
        self.video_caps_seen = False
        self.tier_logged = False

        self.build_pipeline(software=True)
        self._attach_bus(self.pipeline)
        self.play_requested_at = monotonic()
        self.pipeline.set_state(Gst.State.PAUSED if self.paused else Gst.State.PLAYING)
        self.pipeline.get_state(2 * Gst.SECOND)
        if position > 1.0:
            ok = self.pipeline.seek_simple(
                Gst.Format.TIME,
                Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                int(position * Gst.SECOND))
            log("fallback: seek to", hms(position), "->", "ok" if ok else "refused")
            self.target_position = position
            self.target_set_at = monotonic()
        if self.osd:
            self.osd.show(label=tr("osd.software_decode"), right="", duration=3.0)

    def _watchdog(self):
        """Tier 1 must reach PLAYING within FALLBACK_START_TIMEOUT.

        A broken hardware decoder can stall instead of posting an error, so
        the absence of PLAYING is a failure signal too. The watchdog is a
        one-shot: it removes itself once the tier has been decided."""
        if self.finished or self.tier != 1 or self.fallback_done:
            return False
        # Test hook: drop to software at a chosen position instead of waiting
        # for a real negotiation failure, so the resume seek is exercised at
        # something other than zero. Inactive unless KMS_PLAY_FORCE_SOFT_AT is
        # set; it triggers once and then behaves like any other fallback.
        if FORCE_SOFT_AT is not None:
            try:
                here = self.position()
            except Exception:
                here = 0.0
            if here >= FORCE_SOFT_AT:
                log("test hook: forcing software tier at %s" % hms(here))
                self.degrade_to_software(
                    "forced at %s by KMS_PLAY_FORCE_SOFT_AT" % hms(here))
                return False
        if monotonic() - self.play_requested_at < FALLBACK_START_TIMEOUT:
            return True
        ok, state, pending = self.pipeline.get_state(0)
        if ok and state == Gst.State.PLAYING:
            if not self.tier_logged:
                self.tier_logged = True
                log("decode tier: hardware (state PLAYING, no video caps yet)")
            return False
        self.degrade_to_software(
            "tier 1 did not reach PLAYING in %.0f s (state %s, pending %s)"
            % (FALLBACK_START_TIMEOUT, state.value_nick, pending.value_nick))
        return False

    # -- seek / volume -----------------------------------------------------

    def position(self):
        """Current playback position in seconds.

        Right after a seek the pipeline still reports the old position for a
        moment; during that window the requested target is returned instead so
        that successive seeks accumulate exactly on the scale."""
        if self.target_position and monotonic() - self.target_set_at < 0.8:
            return self.target_position
        ok, pos = self.pipeline.query_position(Gst.Format.TIME)
        return pos / Gst.SECOND if ok and pos >= 0 else self.target_position

    def duration_s(self):
        if self.duration:
            return self.duration
        ok, duration = self.pipeline.query_duration(Gst.Format.TIME)
        if ok and duration > 0:
            self.duration = duration / Gst.SECOND
        return self.duration

    def seek_step(self, direction, now=None):
        """Return the signed step to apply, or None if the press is debounced.

        THE SCALE (validated by Thony, 2026-11-15), not a hold acceleration:
          - each accepted press jumps the CURRENT rung and then advances one
            rung: 1, 10, 30, 60, 120, 240 s, clamped at 240 s;
          - the index restarts at 1 s after SEEK_RESET_AFTER without a press;
          - it restarts at 1 s as soon as the direction flips;
          - press and autorepeat are both "presses": a held arrow walks the
            scale, exactly like tapping it;
          - SEEK_DEBOUNCE prevents one physical press (press event followed by
            fast repeats) from consuming two rungs.

        `now` is when the event was READ, not when it is handled: a seek to a
        distant keyframe blocks the main loop for up to a second, and timing
        the ladder on handling time would reset the scale between two taps the
        viewer made 400 ms apart. The direction is tracked here, so a change
        of direction is detected even if the other key's release was lost."""
        now = monotonic() if now is None else now
        if direction != self.seek_direction:
            self.seek_direction = direction
            self.seek_index = 0
            self.seek_last_at = 0.0
        elif now - self.seek_last_at > SEEK_RESET_AFTER:
            # Idle: back to the smallest step, silently.
            self.seek_index = 0
        if self.seek_last_at and now - self.seek_last_at < SEEK_DEBOUNCE:
            log("seek: debounced (%.0f ms)" % ((now - self.seek_last_at) * 1000))
            return None
        rung = self.seek_index
        step = SEEK_SCALE[rung]
        self.seek_index = min(rung + 1, len(SEEK_SCALE) - 1)
        self.seek_last_at = now
        log("seek: rung %d/%d = %.1f s" % (rung + 1, len(SEEK_SCALE), step))
        return direction * step

    def seek(self, delta, origin="key"):
        """Jump `delta` seconds from the current position.

        The OSD is updated BEFORE the pipeline seek so feedback never waits for
        the decoder. The target is clamped to [0, duration - 0.25 s]: seeking
        to the very end would raise EOS and stop playback."""
        base = self.position()
        target = base + delta
        duration = self.duration_s()
        if duration:
            target = min(target, max(0.0, duration - 0.25))
        target = max(0.0, target)
        self.target_position = target
        self.target_set_at = monotonic()
        self.show_seek_osd(delta)
        started = monotonic()
        ok = self.pipeline.seek_simple(Gst.Format.TIME,
                                       Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                                       int(target * Gst.SECOND))
        log("seek %s %.1fs -> %s (%.1f ms, %s)" % (origin, delta, hms(target),
                                                    (monotonic() - started) * 1000,
                                                    "ok" if ok else "refused"))

    def show_seek_osd(self, step=None):
        """Draw the progress bar plus the signed step (or the pause state)."""
        position = self.position()
        duration = self.duration_s() or 0
        fraction = (position / duration) if duration else 0.0
        if self.paused:
            label = tr("osd.pause")
        else:
            label = format_step(step) if step else ""
        self.osd.show(label=label,
                      fraction=fraction,
                      right=("%s / %s" % (hms(position), hms(duration)))
                            if duration else hms(position),
                      duration=3600 if self.paused else 1.2,
                      persistent=self.paused)

    def software_volume(self, delta_percent):
        """Arrow Up/Down: software gain of the player, not the sink volume.

        Starts at SOFTWARE_GAIN_START (100 %): the ceiling is already
        reached, so only Down has room — which is what a viewer expects from
        a player that plays at nominal level."""
        self.gain = max(0.0, min(SOFTWARE_GAIN_MAX, self.gain + delta_percent / 100.0))
        self.volume_element.set_property("volume", self.gain)
        percent = int(round(self.gain * 100))
        log("software volume:", percent, "%")
        self.osd.show(label=tr("osd.volume_player"), fraction=self.gain,
                      right=tr("osd.percent", value=percent))

    def system_volume(self, delta_percent, mute=False):
        """Multimedia keys: PipeWire sink volume, shared with the rest of the
        desktop. wpctl expects "5%+" / "5%-": the sign follows the number."""
        env = dict(CHILD_ENV)
        env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % UID)
        command = ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                   "%d%%%s" % (abs(delta_percent), "+" if delta_percent >= 0 else "-")]
        if mute:
            command = ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"]
        result = subprocess.run(command, capture_output=True, text=True, env=env, timeout=3)
        state = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                               capture_output=True, text=True, env=env, timeout=3).stdout.strip()
        match = re.search(r"([0-9.]+)", state)
        fraction = float(match.group(1)) if match else 0.0
        muted = "MUTED" in state
        log("system volume:", state or "?", "| code", result.returncode)
        if muted:
            self.osd.show(label=tr("osd.volume_system"), fraction=fraction,
                          right=tr("osd.muted"))
        else:
            self.osd.show(label=tr("osd.volume_system"), fraction=fraction,
                          right=tr("osd.percent", value=round(fraction * 100)))

    # -- tracks ------------------------------------------------------------

    def next_audio(self):
        if not self.audio:
            self.osd.show(label=tr("osd.no_audio"), right="")
            return
        count = len(self.audio)
        try:
            current = self.pipeline.get_property("current-audio")
        except Exception as exc:
            log("cannot read current-audio:", exc)
            current = 0
        if not isinstance(current, int) or current < 0:
            current = 0
        following = (current + 1) % count
        name, title = language_name(self.audio[following].get("tags") or {})
        label = track_label(name, title)
        if following == current:
            # Single track: playbin would still rebuild its audio branch for a
            # switch to itself, which is pure risk for no gain.
            log("audio track: only one, no switch")
            self.osd.show(label=tr("osd.audio", name=label), duration=1.5)
            return
        if monotonic() - self.audio_switch_at > 5.0:
            self.audio_recoveries = 0
        self.audio_previous = current
        self.audio_switch_at = monotonic()
        try:
            self.pipeline.set_property("current-audio", following)
        except Exception as exc:
            log("audio switch refused:", exc)
            self.osd.show(label=tr("osd.audio_unavailable"), duration=2.0)
            self.audio_switch_at = 0.0
            return
        log("audio track ->", following, "/", count, label, "|", title)
        self.osd.show(label=tr("osd.audio", name=label), duration=1.5)
        if AUDIO_SWITCH_SELFTEST:
            log("self-test: pretending the switch failed")
            self.recover_audio_switch()

    def recover_audio_switch(self, eos=False):
        """Turn a failed audio switch into a no-op instead of the end of the film.

        playbin rebuilds decoder and sink when current-audio changes, and that
        reconfiguration can post ERROR or EOS from the audio branch. Ending the
        film there is wrong: the video side is fine. Put the previous track
        back, re-anchor the pipeline and keep playing.

        Returns True when the message was absorbed, False when it must still be
        treated as a real error or a real end of stream."""
        if not self.audio_switch_at:
            return False
        if monotonic() - self.audio_switch_at > AUDIO_SWITCH_GRACE:
            return False
        if eos:
            # A genuine EOS arrives near the end of the film; anything earlier
            # right after a switch is the reconfiguration talking.
            position = self.position()
            if self.duration and position < self.duration - 10:
                log("spurious EOS during audio switch at %s, ignoring" % hms(position))
            else:
                return False
        if self.audio_recoveries >= 2:
            log("audio recovery already attempted twice, giving up")
            return False
        self.audio_recoveries += 1
        previous = self.audio_previous
        log("audio switch failed, restoring track", previous)
        self.audio_switch_at = 0.0
        if previous is None:
            return False
        try:
            self.pipeline.set_property("current-audio", previous)
            self.pipeline.seek_simple(Gst.Format.TIME,
                                      Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                                      int(max(0.0, self.position()) * Gst.SECOND))
        except Exception as exc:
            log("audio restore failed:", exc)
            return False
        self.audio_switch_at = monotonic()
        self.osd.show(label=tr("osd.audio_unavailable"), duration=2.5)
        return True

    def next_subtitle(self):
        """Cycle text tracks, then "off", then back to the first track."""
        if self.planes["sub"] is None:
            self.osd.show(label=tr("osd.no_subtitles"), right="", duration=1.5)
            return
        if not self.subs:
            self.osd.show(label=tr("osd.no_subtitles"), right="", duration=1.5)
            return
        if not self.subtitles_enabled:
            self.subtitles_enabled = True
            self.sub_index = 0
        else:
            self.sub_index += 1
            if self.sub_index >= len(self.subs):
                self.subtitles_enabled = False
        if not self.subtitles_enabled:
            self.subtitles.cues = []
            self.subtitles.current = None
            self.subtitles._clear()
            log("subtitles -> off")
            self.osd.show(label=tr("osd.subtitles_off"), right="", duration=1.5)
            return
        stream = self.subs[self.sub_index]
        name, title = language_name(stream.get("tags") or {})
        log("subtitles -> stream", stream["index"], name, "|", title)
        self.osd.show(label=tr("osd.subtitles", name=name), duration=1.5)
        # Extraction happens in a thread: the OSD must never wait for ffmpeg.
        import threading
        threading.Thread(target=self.load_subtitles, args=(stream,), daemon=True).start()

    def load_subtitles(self, stream):
        srt_path = extract_srt(self.media_path, stream["index"])
        cues = parse_srt(srt_path) if srt_path else []
        log("subtitles loaded:", srt_path, "|", len(cues), "cues")

        # The worker thread must not touch the cairo/DRM state concurrently
        # with the main loop, so the swap is posted to the GLib loop.
        def apply():
            self.subtitles.current = None
            self.subtitles.cues = cues
            if not cues:
                self.subtitles._clear()
            return False

        GLib.idle_add(apply, priority=GLib.PRIORITY_DEFAULT)

    # -- playback ----------------------------------------------------------

    def toggle_pause(self):
        if self.paused:
            self.pipeline.set_state(Gst.State.PLAYING)
            self.paused = False
            log("state: PLAYING")
            self.osd.persistent = False
            self.osd.show(label=tr("osd.play"),
                          fraction=(self.position() / (self.duration_s() or 1)),
                          right=hms(self.position()))
        else:
            # PAUSED keeps the last frame on screen: kmssink holds the plane.
            self.pipeline.set_state(Gst.State.PAUSED)
            self.paused = True
            log("state: PAUSED")
            position = self.position()
            duration = self.duration_s() or 0
            self.osd.show(label=tr("osd.pause"),
                          fraction=(position / duration) if duration else 0.0,
                          right=hms(position), duration=3600, persistent=True)

    # -- keyboard ----------------------------------------------------------

    def start_keyboard(self):
        try:
            self.keyboard = subprocess.Popen([KEYS_DAEMON], stdout=subprocess.PIPE,
                                             bufsize=0, env=CHILD_ENV)
        except Exception as exc:
            die("kms-keys: %s" % exc)
        self._keyboard_dead = False
        import threading
        threading.Thread(target=self._keyboard_loop, daemon=True).start()
        GLib.timeout_add(200, self._tick_keyboard_alive)
        log("kms-keys started, pid", self.keyboard.pid)

    def _tick_keyboard_alive(self):
        if self.finished:
            return False
        if self._keyboard_dead or self.keyboard.poll() is not None:
            log("kms-keys exited, stopping")
            self.stop("keyboard gone")
            return False
        return True

    def _keyboard_loop(self):
        """Read kms-keys on a dedicated thread and push each line to GLib.

        A raw os.read() loop is used instead of io_add_watch because the watch
        proved fragile over long sessions (it stopped firing after hours)."""
        fd = self.keyboard.stdout.fileno()
        buffer = b""
        try:
            while True:
                data = os.read(fd, 8192)
                if not data:
                    break
                buffer += data
                *lines, buffer = buffer.split(b"\n")
                for raw in lines:
                    fields = raw.decode("utf-8", "replace").split()
                    if len(fields) >= 3 and fields[0] == "key":
                        try:
                            value = int(fields[2])
                        except ValueError:
                            continue
                        code = 0
                        if len(fields) >= 4:
                            try:
                                code = int(fields[3])
                            except ValueError:
                                code = 0
                        name = self.keylayout.token(code, fields[1], value)
                        # Stamp at read time: the main loop may already be
                        # busy with a seek, and the ladder must follow the
                        # viewer's cadence, not our latency.
                        GLib.idle_add(self._dispatch_key, name, value,
                                      monotonic(), priority=GLib.PRIORITY_HIGH)
        except Exception as exc:
            log("keyboard: read error:", exc)
        self._keyboard_dead = True

    def _dispatch_key(self, name, value, seen=None):
        try:
            self.on_key(name, value, seen)
        except Exception as exc:
            import traceback
            log("ERROR key %s: %s" % (name, exc))
            traceback.print_exc(file=log_file)
        return False

    def on_key(self, name, value, seen=None):
        """Handle one keyboard event. value: 0 release, 1 press, 2 repeat."""
        if self.finished:
            return
        log("key", name, value, "t=%.6f" % monotonic())
        # The startup panel belongs to the first moments of playback: any key
        # takes the plane back from it, before the key is interpreted, since
        # the pressed key may need the bottom band right away. The on-demand
        # panel (I) is deliberately not cancelled here: it is read while
        # seeking, so only I closes it.
        if self.osd is not None:
            self.osd.cancel_panel("key %s" % name, kind="startup")
        press = (value == 1)
        if name == "I" and press:
            self.toggle_info_panel()
            return
        if name in ("ESC", "Q"):
            if press:
                self.stop("key %s" % name)
            return
        if name in ("LEFT", "RIGHT"):
            # Both press and autorepeat advance the cumulative scale; the
            # debounce inside seek_step() decides what is accepted.
            if value != 0:
                step = self.seek_step(-1 if name == "LEFT" else 1, seen)
                if step is not None:
                    self.seek(step, "scale")
            return
        if name == "A" and press:
            self.next_audio()
        elif name == "S" and press:
            self.next_subtitle()
        elif name in ("SPACE", "PLAYPAUSE") and press:
            self.toggle_pause()
        elif name == "ENTER" and press:
            log("osd toggled ->", self.osd.toggle())
        elif name == "UP" and press:
            self.software_volume(SOFTWARE_GAIN_STEP)
        elif name == "DOWN" and press:
            self.software_volume(-SOFTWARE_GAIN_STEP)
        elif name == "VOLUMEUP" and press:
            self.system_volume(+5)
        elif name == "VOLUMEDOWN" and press:
            self.system_volume(-5)
        elif name == "MUTE" and press:
            self.system_volume(0, mute=True)
        elif name == "NEXTSONG" and press:
            self.seek(60, "next")
        elif name == "PREVIOUSSONG" and press:
            self.seek(-60, "previous")

    def _tick_subtitles(self):
        if self.finished:
            return False
        # After a seek the position is transient for a few hundred ms; showing
        # cues during that window makes the subtitle plane flicker (each cue is
        # a SetPlane on the DRM fd, which shares the master with the video).
        if monotonic() - self.target_set_at < 0.5:
            return True
        if self.subtitles and self.subtitles.cues:
            self.subtitles.update(self.position())
        return True

    def _tick_osd(self):
        if self.finished:
            return False
        return self.osd.tick(monotonic())

    # -- lifecycle ---------------------------------------------------------

    def on_message(self, bus, message):
        message_type = message.type
        if message_type == Gst.MessageType.EOS:
            if self.recover_audio_switch(eos=True):
                return
            log("end of stream (EOS)")
            self.stop("end of stream")
        elif message_type == Gst.MessageType.ERROR:
            error, debug = message.parse_error()
            log("PIPELINE ERROR:", error.message, "|", debug)
            if self.recover_audio_switch():
                return
            if self.tier == 1:
                # Any tier 1 error is worth one software attempt: the common
                # case is a hardware decoder that cannot negotiate DMABuf caps
                # with kmssink (not-negotiated -4), and force-sw-decoders
                # sidesteps it completely.
                reason = "not-negotiated" if "not-negotiated" in (error.message + debug) \
                    else error.message
                self.degrade_to_software(reason)
                return
            log("decode tier: none (software fallback failed)")
            if self.osd:
                self.osd.show(label=tr("osd.playback_failed"), right="", duration=5)
            self.stop("error")
        elif message_type == Gst.MessageType.STATE_CHANGED and message.src == self.pipeline:
            _old, new, _pending = message.parse_state_changed()
            if new in (Gst.State.PLAYING, Gst.State.PAUSED):
                log("pipeline state:", new.value_nick)

    def stop(self, reason="requested"):
        """Tear everything down in an order that leaves the console usable.

        The order is the fix for the black screen reported after a playback:
        the pipeline is brought to NULL and awaited (kmssink frees its plane
        during that transition), then kms-subd is asked to detach all three
        planes, then the result is read back. Relying on the GStreamer teardown
        alone leaves the video plane scanning out over the console."""
        if self.finished:
            return
        self.finished = True
        self.stop_reason = reason
        log("stop requested (%s)" % reason)
        try:
            if self.osd is not None:
                self.osd.cancel_panel("stop")
                self.osd.hide()
        except Exception:
            pass
        try:
            if self.subtitles:
                self.subtitles._clear()
        except Exception:
            pass
        self._teardown_pipeline()
        self._release_planes()
        self.main_loop.quit()

    def _teardown_pipeline(self):
        """Bring the pipeline to NULL and wait for it, bounded and logged.

        set_state(NULL) only queues the transition; kmssink detaches its plane
        while handling it. Releasing the plane before that happened races with
        the sink, which can re-enable it."""
        if self.pipeline is None:
            return
        started = monotonic()
        try:
            self.pipeline.set_state(Gst.State.NULL)
            _result, state, _pending = self.pipeline.get_state(2 * Gst.SECOND)
        except Exception as exc:
            log("pipeline: teardown failed:", exc)
            return
        elapsed = (monotonic() - started) * 1000
        if state == Gst.State.NULL:
            log("pipeline: NULL in %.0f ms" % elapsed)
        else:
            log("pipeline: teardown slow, state=%s after %.0f ms"
                % (state.value_nick, elapsed))

    def _release_planes(self):
        """Detach the video, subtitle and OSD planes, then check the result.

        kms-subd holds the DRM master, so it is the one that can set fb_id 0 on
        all three planes; the state is then read back with kms-planes instead
        of being assumed, and a plane still programmed is logged as a warning
        (never silently)."""
        self.planes_released = False
        subdaemon = getattr(self, "subdaemon", None)
        if subdaemon is None:
            return False
        try:
            subdaemon.stdin.write("off\n")
            subdaemon.stdin.flush()
        except Exception as exc:
            log("planes: cannot ask kms-subd to release them:", exc)
            return False
        for attempt in (1, 2, 3):
            busy = planes_in_use()
            if not busy:
                log("planes: released, no framebuffer left on any plane")
                self.planes_released = True
                return True
            log("planes: still programmed:", busy, "| attempt", attempt)
            time.sleep(0.2)
        log("planes: WARNING still programmed after 3 attempts:", planes_in_use())
        return False

    def console_status(self):
        """The one line written to the console VT after playback ends.

        ASCII English on purpose, whatever the language: the kernel console
        font has no non-Latin coverage, so a translated line would come out as
        question marks and the screen would look broken again. The strings live
        in the table like every other label; only `en` is filled, which makes
        `tr()` fall back to English for the other 29 entries."""
        name = console_text(os.path.basename(self.media_path))
        key = "console.finished" if self.stop_reason == "end of stream" \
            else "console.stopped"
        return tr(key, name=name)

    def run(self):
        if not os.path.isfile(self.media_path):
            die("file not found: %s" % self.media_path)

        self.switch_vt()
        self.start_subdaemon()
        self.inhibit_session()
        self.build_pipeline()
        self.start_keyboard()

        self._attach_bus(self.pipeline)

        # 12.5 Hz for subtitles is enough for human dialogue and cheap; 10 Hz
        # for the OSD matches its rate limit.
        GLib.timeout_add(80, self._tick_subtitles)
        GLib.timeout_add(100, self._tick_osd)
        GLib.timeout_add(1000, self._watchdog)

        signal.signal(signal.SIGTERM, lambda *a: self.stop("signal"))
        signal.signal(signal.SIGINT, lambda *a: self.stop("signal"))

        self.play_requested_at = monotonic()
        self.pipeline.set_state(Gst.State.PLAYING)
        self.pipeline.get_state(2 * Gst.SECOND)

        # First subtitle track, extracted in the background.
        if self.subtitles_enabled and self.subs:
            import threading
            threading.Thread(target=self.load_subtitles,
                             args=(self.subs[self.sub_index],), daemon=True).start()

        self.main_loop.run()

        # Shutdown sequence. A path that ended the loop without stop() must not
        # leave a plane programming the screen, so the teardown is idempotent
        # and runs again here when the first pass did not record success.
        if not self.planes_released:
            log("exit: planes not confirmed released, repeating teardown")
            self._teardown_pipeline()
            self._release_planes()
        try:
            self.keyboard.terminate()
            self.keyboard.wait(timeout=1.5)
        except Exception:
            try:
                self.keyboard.kill()
                self.keyboard.wait(timeout=1.5)
            except Exception:
                pass
        if self.subdaemon:
            try:
                self.subdaemon.stdin.write("quit\n")
                self.subdaemon.stdin.flush()
            except Exception:
                pass
            try:
                self.subdaemon.wait(timeout=3)
            except Exception:
                self.subdaemon.kill()
        self.release_inhibit()
        exit_to_vt(self.return_vt, self.return_kind, self.console_status())
        log("exit: previous tty%s | planes released: %s"
            % (self.previous_vt, self.planes_released))


LOCK_HANDLE = [None]


def single_instance_lock():
    """Refuse to start twice: only one process can hold the DRM master, and a
    second player would fight over the planes and the VT."""
    import fcntl
    handle = open("/tmp/kms-play-%d.lock" % UID, "w")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("kms-play: a playback is already running", file=sys.stderr)
        sys.exit(3)
    LOCK_HANDLE[0] = handle


def main():
    set_language(detect_language())
    if len(sys.argv) < 2:
        print("usage: kms-play <file>", file=sys.stderr)
        sys.exit(2)
    single_instance_lock()
    media_path = os.path.realpath(sys.argv[1])
    player = Player(media_path)
    player.run()


if __name__ == "__main__":
    main()
