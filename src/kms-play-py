def probe_media(path):
    """List audio and text subtitle streams of the container.

    Only text codecs are kept: image-based subtitles (PGS/DVD) cannot be
    rendered by Pango and would need a bitmap path we do not implement.
    Returns (audio_streams, subtitle_streams, video_stream), the last one being
    the first video stream (or {}) used as a fallback by the startup banner
    when the negotiated caps do not carry every field."""
    proc = subprocess.run(["ffprobe", "-v", "error", "-show_entries",
                           "stream=index,codec_type,codec_name,profile,width,height,"
                           "r_frame_rate:stream_tags=language,title",
                           "-of", "json", path], capture_output=True, text=True)
    try:
        streams = json.loads(proc.stdout or "{}").get("streams", [])
    except Exception as exc:
        log("ffprobe output unreadable:", exc)
        return [], [], {}
    audio, subs, video = [], [], {}
    for stream in streams:
        if stream.get("codec_type") == "audio":
            audio.append(stream)
        elif stream.get("codec_type") == "subtitle" and stream.get("codec_name") in (
                "subrip", "ass", "ssa", "mov_text", "webvtt"):
            subs.append(stream)
        elif stream.get("codec_type") == "video" and not video:
            video = stream
    return audio, subs, video


def write_surface(raw_path, geom_path, surface, width, height):
    """Write an overlay buffer and its geometry side by side.

    The raw file holds the pixels, the geom file says how wide and high they
    are: the OSD surface changes shape between the bottom band and the startup
    banner, and kms-shot reads the buffer back without any other context. The
    geometry is replaced atomically (tmp + rename) so a capture running at the
    same time never sees half a size."""
    with open(raw_path, "wb") as handle:
        handle.write(bytes(surface.get_data()))
    tmp = geom_path + ".tmp"
    with open(tmp, "w") as handle:
        handle.write("%dx%d\n" % (width, height))
    os.replace(tmp, geom_path)


def display_info():
    """Connector name, active mode and refresh rate, from kms-planes.

    Read once at startup. /sys/class/drm/*/modes only lists the modes a
    connector accepts, never which one is being scanned out, and says nothing
    about the vertical refresh: only the kernel's CRTC state knows both, which
    is what kms-planes prints. A connector whose CRTC is not routed yet shows
    its preferred mode, flagged as such, instead of pretending it is live."""
    info = {"name": None, "width": 0, "height": 0, "vrefresh": 0}
    try:
        out = subprocess.run([PLANES_TOOL], capture_output=True, text=True,
                             timeout=5, env=CHILD_ENV).stdout
    except Exception as exc:
        log("display info: kms-planes failed:", exc)
        return info
    for line in out.splitlines():
        match = re.match(r"connector (\S+) connected crtc=\d+ mode=(\d+)x(\d+) "
                         r"vrefresh=(\d+)", line)
        if not match:
            continue
        candidate = {"name": match.group(1), "width": int(match.group(2)),
                     "height": int(match.group(3)), "vrefresh": int(match.group(4))}
        if "preferred" not in line:
            return candidate           # live CRTC mode: authoritative
        if info["name"] is None:
            info = candidate           # keep as a fallback, keep looking
    return info


def plane_state(plane_id):
    """fmt/zpos/fb of one plane right now, from kms-planes --short.

    Called when the banner is about to be drawn, not at startup: before the
    first frame the plane has no framebuffer (fmt "-"). Once the decoder is
    feeding it, fmt is the DRM fourcc of the buffer actually scanned out, and
    that is the value the banner must show (NV15 for 10-bit HEVC, even though
    the GStreamer caps call it DMA_DRM or P010_10LE)."""
    try:
        out = subprocess.run([PLANES_TOOL, "--short"], capture_output=True, text=True,
                             timeout=5, env=CHILD_ENV).stdout
    except Exception:
        return {}
    for line in out.splitlines():
        match = re.search(r"plane %d zpos=(\d+) fb=(\d+) fmt=(\S+)" % plane_id, line)
        if match:
            return {"zpos": int(match.group(1)), "fb": int(match.group(2)),
                    "fmt": match.group(3)}
    return {}


