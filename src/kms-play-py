# Placeholders are part of the contract: a translation that drops {fmt} would
# print a sentence with a hole in it, so this is checked once at import.
_PLACEHOLDER = re.compile(r"\{(\w+)\}")
for _code, _table in _TABLES.items():
    for _key, _text in _table.items():
        if _text and sorted(_PLACEHOLDER.findall(_text)) != \
                sorted(_PLACEHOLDER.findall(_TABLES["en"][_key])):
            raise SystemExit("i18n: %s/%s has different placeholders" % (_code, _key))


def normalise_language(tag):
    """Reduce a locale tag to one of our language codes.

    Accepts what the environment actually contains: "fr_FR.UTF-8",
    "ja_JP.utf8", "zh_TW", "zh-Hant-HK", "pt_BR", "C". Region decides the
    Chinese variant; every other language is one entry whatever the region."""
    tag = (tag or "").strip()
    if not tag or tag in ("C", "POSIX"):
        return ""
    # Drop encoding and modifier: "fr_FR.UTF-8@euro" -> "fr_FR".
    tag = tag.split(":")[0].split(".")[0].split("@")[0]
    parts = tag.replace("-", "_").split("_")
    base = parts[0].lower()
    region = parts[1].upper() if len(parts) > 1 else ""
    if base == "zh":
        if region in ("TW", "MO"):
            return "zh-Hant"
        if region == "HK":
            return "zh-HK"
        if region in ("CN", "SG"):
            return "zh-Hans"
        # A bare "zh" or an unknown region: Simplified is the safer default,
        # it is the writing system of the largest number of readers.
        return "zh-Hans"
    if base in ("he", "iw"):
        return "he"
    if base in ("id", "in"):
        return "id"
    return base


def detect_language():
    """The language to display: KMS_PLAY_LANG, then the usual locale vars.

    Order is the one asked for: explicit override, LC_MESSAGES, LANG, then
    LANGUAGE (a colon-separated list, first entry wins). Anything absent or
    unrecognised falls back to English rather than to an empty panel."""
    for variable in ("KMS_PLAY_LANG", "LC_MESSAGES", "LANG", "LANGUAGE"):
        value = os.environ.get(variable) or ""
        for candidate in value.split(":"):
            code = normalise_language(candidate)
            if code in STRINGS:
                return code
    return "en"


LANGUAGE = detect_language()
_FALLBACK_KEYS = set()          # {(language, key)} already reported
_MEASURE = {}                   # lazily built measuring layout


def language():
    """The active language code."""
    return LANGUAGE


def set_language(code, quiet=False):
    """Switch language; used at startup and by src/test-i18n.py."""
    global LANGUAGE
    LANGUAGE = code if code in STRINGS else "en"
    _FALLBACK_KEYS.clear()
    if not quiet:
        log("i18n: language %s (%s)" % (LANGUAGE, "rtl" if is_rtl() else "ltr"))
    return LANGUAGE


def font_family(lang=None):
    """The font family to draw `lang` with (see FONT_FAMILIES)."""
    return FONT_FAMILIES.get(lang or LANGUAGE, DEFAULT_FONT_FAMILY)


def font_description(style="", lang=None):
    """Pango description for a language, e.g. font_description("Bold 16").

    The family is picked here rather than left to fontconfig's fallback,
    which does not distinguish the CJK regional variants."""
    return Pango.FontDescription(("%s %s" % (font_family(lang), style)).strip())


def is_rtl(lang=None):
    return (lang or LANGUAGE) in RTL_LANGUAGES


def apply_direction(layout, lang=None):
    """Set the base direction of a layout: RTL for ar/fa/he, auto otherwise.

    The base direction lives on the layout's PangoContext, not on the layout:
    Pango.Layout only exposes auto-dir. Auto-dir is switched off for RTL so a
    line that happens to start with a Latin value ("Plane 57 ...") is still
    laid out right to left instead of flipping the whole panel."""
    context = layout.get_context()
    if is_rtl(lang):
        context.set_base_dir(Pango.Direction.RTL)
        layout.set_auto_dir(False)
        layout.set_alignment(Pango.Alignment.RIGHT)
    else:
        context.set_base_dir(Pango.Direction.LTR)
        layout.set_auto_dir(True)
        layout.set_alignment(Pango.Alignment.LEFT)


def _missing_glyphs(text, lang=None):
    """True when the language's font cannot draw `text`.

    Measured on a throw-away 1x1 surface: the answer depends on the font and
    the string only, not on the panel being drawn."""
    if "surface" not in _MEASURE:
        _MEASURE["surface"] = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1)
        _MEASURE["layout"] = PangoCairo.create_layout(cairo.Context(_MEASURE["surface"]))
    layout = _MEASURE["layout"]
    layout.set_font_description(font_description("15", lang))
    layout.set_text(text, -1)
    return layout.get_unknown_glyphs_count() > 0


def tr(key, **values):
    """The string for `key` in the current language, formatted.

    Two fallbacks, silent on screen and explicit in the log: a missing key
    (partial translation) uses English, and a string the language's font
    cannot draw is replaced by its English form instead of being shown as
    boxes. The second one is the anti-tofu guarantee; it is measured, not
    assumed, because a font package can be missing at runtime."""
    template = _TABLES[LANGUAGE].get(key) or _TABLES["en"][key]
    text = template.format(**values) if values else template
    if LANGUAGE != "en" and (LANGUAGE, key) not in _FALLBACK_KEYS:
        if _missing_glyphs(text):
            _FALLBACK_KEYS.add((LANGUAGE, key))
            log("i18n: %s missing glyphs, falling back to en (%s)" % (LANGUAGE, key))
            template = _TABLES["en"][key]
            text = template.format(**values) if values else template
    return text


# Container language tags -> our display-name keys. Matroska uses ISO 639-2
# ("fre", "ger"), ffprobe sometimes reports the 639-1 form ("fr").
LANGUAGE_KEYS = {
    "fre": "lang.fr", "fra": "lang.fr", "fr": "lang.fr",
    "eng": "lang.en", "en": "lang.en",
    "spa": "lang.es", "es": "lang.es",
    "ger": "lang.de", "deu": "lang.de", "de": "lang.de",
    "ita": "lang.it", "it": "lang.it",
    "jpn": "lang.ja", "ja": "lang.ja",
    "chi": "lang.zh", "zho": "lang.zh", "zh": "lang.zh",
    "kor": "lang.ko", "ko": "lang.ko",
    "por": "lang.pt", "pt": "lang.pt",
    "rus": "lang.ru", "ru": "lang.ru",
    "ara": "lang.ar", "ar": "lang.ar",
    "nld": "lang.nl", "dut": "lang.nl", "nl": "lang.nl",
    "pol": "lang.pl", "pl": "lang.pl",
    "swe": "lang.sv", "sv": "lang.sv",
    "dan": "lang.da", "da": "lang.da",
    "nor": "lang.nb", "nb": "lang.nb", "no": "lang.nb",
    "fin": "lang.fi", "fi": "lang.fi",
    "tur": "lang.tr", "tr": "lang.tr",
    "hin": "lang.hi", "hi": "lang.hi",
    "und": "lang.und",
}


def language_name(tags):
    """Return (display name, raw title) for a stream's tags.

    The name is localized for the screen; the title is passed through so the
    caller can build "French — VFF" (the name is in the selected language).
    Unknown language codes are shown as the upper-cased tag rather than being
    hidden."""
    lang = (tags.get("language") or "").lower()
    title = tags.get("title") or ""
    key = LANGUAGE_KEYS.get(lang)
    if key:
        return tr(key), title
    return (lang.upper() if lang else tr("lang.und")), title


def short_title(title):
    """Strip the technical bitrate suffix (" @ 640 kbps") from a track title.

    ffprobe often reports titles such as "VFF @ 640 kbps"; the bitrate is
    noise on screen and makes the OSD label longer than the bar."""
    t = re.sub(r"\s*@\s*[\d.,]+\s*kbps\s*$", "", (title or "").strip(), flags=re.I)
    return re.sub(r"\s+", " ", t).strip()


def track_label(name, title):
    """Build the audio label: "French — VFF" when a distinct title exists.

    The language name comes from the table, so the same track reads
    "Français — VFF" in French and "French — VFF" in English."""
    t = short_title(title)
    if t and t.lower() != name.lower():
        return "%s — %s" % (name, t)
    return name


def hms(seconds):
    """Format a duration as m:ss or h:mm:ss."""
    seconds = max(0, int(seconds))
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return "%d:%02d:%02d" % (hours, minutes, secs)
    return "%d:%02d" % (minutes, secs)


def format_step(delta):
    """Format a seek step with its sign, in the current language.

    The sign matters: "−0,5 s" and "+0,5 s" are different actions and the OSD
    is the only feedback the user gets. Only French is given a decimal comma:
    the seek scale is whole seconds, so the fractional branch is a safety net
    rather than something the viewer sees."""
    sign = "+" if delta >= 0 else "−"
    value = abs(delta)
    if value >= 1.0:
        number = str(int(value))
    else:
        number = "%.1f" % value
        if LANGUAGE == "fr":
            number = number.replace(".", ",")
    return tr("osd.seek_step", sign=sign, value=number)


def format_panel_lines(values, filename=None):
    """The information panel, localized, from already-resolved values.

    A module function rather than a Player method so that src/test-i18n.py
    renders the real composition: it feeds fixed values and gets exactly what
    the player would draw, in every language.

    Returns one entry per line, either a string or, for an RTL language, a
    (label, technical) pair for the plane line. The pair exists because bidi
    cannot be trusted to keep both orders inside one paragraph: Pango ignores
    the explicit LRE/PDF embedding that would have isolated the values, so the
    label is drawn right-aligned in its own RTL layout and the technical run
    left-aligned in its own LTR layout. Measured: in a single RTL paragraph
    "Plane 57 · NV15" came out as "57 ... NV15" with the number detached.

    Every technical value is a kernel or caps fact (a fourcc, a plane id, a
    connector name, a negotiated caps name). "values" keys:
        hardware   bool   tier 1 with DMABuf caps
        codec, profile, definition, rate   strings, may be empty
        plane, fmt, caps_fmt               strings, "fmt" never empty
        dmabuf     bool
        zpos       int or None
        connector, width, height, vrefresh
    """
    lines = [tr("panel.hardware") if values.get("hardware") else tr("panel.software")]

    codec_name = " ".join(part for part in (values.get("codec"), values.get("profile")) if part)
    codec_line = " · ".join(part for part in (codec_name, values.get("definition"),
                                              values.get("rate")) if part)
    lines.append(codec_line)

    fmt = values.get("fmt") or "?"
    # The plane scans out what kmssink accepted; the decoder output can be a
    # different fourcc (I420 through videoconvert becomes NV12). Show both when
    # they differ; skip DMA_DRM, which only says "a DRM buffer" and is not a
    # layout.
    caps_fmt = values.get("caps_fmt") or ""
    if caps_fmt and caps_fmt != fmt and caps_fmt not in ("DMA_DRM", "?"):
        fmt = "%s %s" % (fmt, tr("panel.negotiated", fmt=caps_fmt))
    technical = [str(values.get("plane", "?")), fmt,
                 tr("panel.mem_dmabuf") if values.get("dmabuf") else tr("panel.mem_system")]
    if values.get("zpos") is not None:
        technical.append(tr("panel.zpos", value=values["zpos"]))
    tech = " · ".join(technical)
    if is_rtl():
        lines.append((tr("panel.plane"), tech))
    else:
        lines.append("%s %s" % (tr("panel.plane"), tech))

    sline = tr("panel.screen", name=values.get("connector") or "screen",
               width=values.get("width") or 0, height=values.get("height") or 0)
    if values.get("vrefresh"):
        sline += " " + tr("panel.refresh", hz=values["vrefresh"])
    lines.append(sline)

    if filename:
        lines.append(filename)
    return lines


def panel_line_text(line):
    """A panel line as one string, for the log (a line may be a pair)."""
    return " ".join(line) if isinstance(line, tuple) else line


