# ---------------------------------------------------------------------------
# Player manager: one player at a time, driven over its unix socket
# ---------------------------------------------------------------------------
class PlayerManager:
    """Owns the single player process and mirrors its state for UPnP.

    Every UPnP query reads the cache in `self`; a background thread refreshes
    it from the player's control socket every half second. Commands are sent
    synchronously with a short timeout, so a stuck player never blocks a SOAP
    reply for longer than that timeout.
    """

    def __init__(self, control_socket, player_command):
        self.control_socket = control_socket
        self.player_command = list(player_command)
        self.lock = threading.RLock()
        self.process = None
        self.uri = ""
        self.metadata = ""
        self.next_uri = ""
        self.next_metadata = ""
        self.state = "NO_MEDIA_PRESENT"
        self.status = "OK"
        self.position = 0.0
        self.duration = 0.0
        self.volume = 100
        self.muted = False
        self.saved_volume = 100
        self.audio_tracks = []
        self.current_audio = 0
        self.tier = 0
        self.video = {}
        self.player_seen = False
        self.stopping = threading.Event()
        self.thread = threading.Thread(target=self._monitor,
                                        name="kms-renderd-monitor",
                                        daemon=True)
        self.thread.start()

    # -- player process ----------------------------------------------------

    def _spawn(self, uri):
        command = self.player_command + [uri]
        environment = dict(os.environ)
        environment["KMS_PLAY_CTL_SOCK"] = self.control_socket
        log.info("starting player: %s", " ".join(command))
        self.process = subprocess.Popen(
            command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True,
            env=environment)
        self.state = "TRANSITIONING"
        self.position = 0.0
        self.duration = 0.0
        self.player_seen = False
        log.info("player pid %d", self.process.pid)

    def _player_alive(self):
        return self.process is not None and self.process.poll() is None

    def _stop_player(self, wait=4.0):
        with self.lock:
            process = self.process
        if process is None:
            return
        if process.poll() is not None:
            with self.lock:
                if self.process is process:
                    self.process = None
            return
        try:
            self._command({"cmd": "stop"}, timeout=2.0, quiet=True)
        except Exception:
            pass
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if process.poll() is not None:
                break
            time.sleep(0.1)
        if process.poll() is None:
            log.warning("player did not stop in %.1f s, sending SIGTERM", wait)
            try:
                process.terminate()
            except Exception:
                pass
            deadline = time.monotonic() + 3.0
            while time.monotonic() < deadline and process.poll() is None:
                time.sleep(0.1)
        if process.poll() is None:
            log.warning("player still alive, killing pid %d", process.pid)
            try:
                process.kill()
            except Exception:
                pass
        try:
            process.wait(timeout=2.0)
        except Exception:
            pass
        with self.lock:
            if self.process is process:
                self.process = None

    # -- control socket ----------------------------------------------------

    def _command(self, request, timeout=2.0, quiet=False):
        """One JSON request to the player's unix socket, one JSON reply."""
        if not quiet:
            log.debug("player <- %s", request)
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(timeout)
        try:
            client.connect(self.control_socket)
            client.sendall((json.dumps(request) + "\n").encode("utf-8"))
            data = b""
            while b"\n" not in data and len(data) < 65536:
                chunk = client.recv(4096)
                if not chunk:
                    break
                data += chunk
        finally:
            try:
                client.close()
            except Exception:
                pass
        line = data.split(b"\n", 1)[0].strip()
        if not line:
            raise OSError("empty reply from the player")
        reply = json.loads(line.decode("utf-8"))
        if not quiet:
            log.debug("player -> %s", reply)
        return reply

    def _monitor(self):
        """Refresh the cache, notice a dead player, keep the volume in sync."""
        while not self.stopping.is_set():
            try:
                with self.lock:
                    alive = self._player_alive()
                    process = self.process
                if process is not None and not alive:
                    code = process.returncode
                    log.info("player exited (code %s)", code)
                    with self.lock:
                        self.process = None
                        self.state = "STOPPED" if self.uri else "NO_MEDIA_PRESENT"
                        self.position = 0.0
                        self.audio_tracks = []
                        self.current_audio = 0
                elif alive:
                    try:
                        reply = self._command({"cmd": "status"}, timeout=1.5,
                                              quiet=True)
                    except Exception:
                        reply = None
                    if reply and reply.get("ok"):
                        push_volume = False
                        with self.lock:
                            if not self.player_seen:
                                self.player_seen = True
                                push_volume = True
                                log.info("player ready: state=%s duration=%.1f",
                                         reply.get("state"), reply.get("duration", 0))
                            self.position = float(reply.get("position") or 0.0)
                            duration = float(reply.get("duration") or 0.0)
                            if duration > 0:
                                self.duration = duration
                            self.audio_tracks = reply.get("audio_tracks") or []
                            self.current_audio = int(reply.get("current_audio") or 0)
                            self.tier = int(reply.get("tier") or 0)
                            self.video = reply.get("video") or {}
                            player_state = reply.get("state")
                            if player_state == "playing":
                                self.state = "PLAYING"
                            elif player_state == "paused":
                                self.state = "PAUSED_PLAYBACK"
                            elif player_state in ("starting",):
                                self.state = "TRANSITIONING"
                            elif player_state == "stopped":
                                self.state = "STOPPED"
                        # The renderer's volume wins over the player's default
                        # 100 %: push it once the socket answers, outside the
                        # lock so a slow player cannot block a SOAP reply.
                        if push_volume:
                            self._apply_volume()
            except Exception as exc:
                log.debug("monitor: %s", exc)
            self.stopping.wait(0.5)

    def _apply_volume(self):
        with self.lock:
            level = 0 if self.muted else self.volume
        try:
            self._command({"cmd": "volume", "volume": level}, timeout=1.5,
                          quiet=True)
        except Exception as exc:
            log.debug("volume: %s", exc)

    # -- UPnP commands -----------------------------------------------------

    def set_uri(self, uri, metadata):
        uri = (uri or "").strip()
        if not uri:
            raise UPnPError(402, "empty CurrentURI")
        scheme = uri.split(":", 1)[0].lower() if ":" in uri else ""
        if scheme not in ("http", "https", "file", "upnp", "rtsp"):
            raise UPnPError(402, "unsupported URI scheme: %s" % (scheme or "-"))
        # A new URI replaces the current transport: stop the player first so
        # the next Play starts from a clean plane, and so a failed decode does
        # not leave a zombie behind the new media.
        with self.lock:
            playing = self._player_alive()
        if playing:
            self._stop_player()
        with self.lock:
            self.uri = uri
            self.metadata = metadata or ""
            self.state = "STOPPED"
            self.position = 0.0
            self.duration = 0.0
            self.audio_tracks = []
            self.current_audio = 0
            self.player_seen = False
        log.info("SetAVTransportURI: %s", uri)

    def set_next_uri(self, uri, metadata):
        # Accepted and remembered; this renderer does not chain on EOS.
        with self.lock:
            self.next_uri = (uri or "").strip()
            self.next_metadata = metadata or ""
        log.info("SetNextAVTransportURI (not chained): %s", uri)

    def play(self):
        with self.lock:
            if not self.uri:
                raise UPnPError(701, "no media set")
            if self._player_alive():
                if self.state == "PAUSED_PLAYBACK":
                    reply = self._command({"cmd": "resume"}, timeout=2.0)
                    if not reply.get("ok"):
                        raise UPnPError(701, reply.get("error"))
                return
            self._spawn(self.uri)

    def pause(self):
        with self.lock:
            if not self._player_alive() or self.state != "PLAYING":
                raise UPnPError(701, "not playing")
            reply = self._command({"cmd": "pause"}, timeout=2.0)
            if not reply.get("ok"):
                raise UPnPError(701, reply.get("error"))
            self.state = "PAUSED_PLAYBACK"

    def stop(self):
        with self.lock:
            playing = self._player_alive()
        if playing:
            self._stop_player()
        with self.lock:
            self.state = "STOPPED" if self.uri else "NO_MEDIA_PRESENT"
            self.position = 0.0
            self.player_seen = False

    def seek(self, unit, target):
        unit = (unit or "").strip().upper()
        if unit not in ("REL_TIME", "ABS_TIME"):
            raise UPnPError(710, "seek mode %s not supported" % (unit or "-"))
        position = parse_time(target)
        with self.lock:
            if not self._player_alive():
                raise UPnPError(701, "not playing")
        # A control point often seeks the instant it sees PLAYING. The player
        # reports PLAYING only once the bus confirms it, but the sink may
        # still be prerolling for a fraction of a second; a refused seek is
        # retried briefly instead of surfacing as a 701.
        reply = None
        for attempt in range(4):
            reply = self._command({"cmd": "seek", "position": position},
                                  timeout=3.0)
            if not reply.get("ok"):
                raise UPnPError(701, reply.get("error") or "seek refused")
            if reply.get("accepted", True):
                break
            log.debug("seek refused by the player, retry %d", attempt + 1)
            time.sleep(0.4)
        else:
            raise UPnPError(701, "the pipeline refused the seek")
        with self.lock:
            self.position = position
        log.info("seek to %s", hms(position))

    def set_volume(self, percent):
        try:
            percent = int(round(float(percent)))
        except (TypeError, ValueError):
            raise UPnPError(402, "invalid volume")
        percent = max(0, min(100, percent))
        with self.lock:
            self.volume = percent
            self.muted = percent == 0
            playing = self._player_alive()
        if playing:
            self._apply_volume()
        log.info("volume %d %%", percent)

    def get_volume(self):
        with self.lock:
            return 0 if self.muted else self.volume

    def set_mute(self, muted):
        with self.lock:
            wanted = bool(muted)
            if wanted == self.muted:
                return
            if wanted:
                self.saved_volume = max(1, self.volume)
                self.volume = 0
            else:
                self.volume = self.saved_volume or 100
            self.muted = wanted
            playing = self._player_alive()
        if playing:
            self._apply_volume()
        log.info("mute %s", "on" if muted else "off")

    def get_mute(self):
        with self.lock:
            return self.muted

    def snapshot(self):
        with self.lock:
            return {
                "state": self.state, "status": self.status,
                "uri": self.uri, "metadata": self.metadata,
                "next_uri": self.next_uri,
                "next_metadata": self.next_metadata,
                "position": self.position, "duration": self.duration,
                "volume": self.get_volume(), "muted": self.muted,
                "audio_tracks": list(self.audio_tracks),
                "current_audio": self.current_audio, "tier": self.tier,
                "video": dict(self.video),
            }

    def shutdown(self):
        self.stopping.set()
        with self.lock:
            alive = self._player_alive()
        if alive:
            self._stop_player(wait=3.0)


