class SSDPServer(threading.Thread):
    def __init__(self, udn, http_port, friendly_name):
        super().__init__(name="kms-renderd-ssdp", daemon=True)
        self.udn = udn
        self.http_port = http_port
        self.friendly_name = friendly_name
        self.stopping = threading.Event()
        self.socket = None
        self.interface_addresses = local_ipv4_addresses()
        self.last_announce = 0.0

    def targets(self):
        """(NT/ST, USN) pairs this device answers for."""
        return [
            ("upnp:rootdevice", "%s::upnp:rootdevice" % self.udn),
            (self.udn, self.udn),
            (DEVICE_TYPE, "%s::%s" % (self.udn, DEVICE_TYPE)),
            (AVT, "%s::%s" % (self.udn, AVT)),
            (RCS, "%s::%s" % (self.udn, RCS)),
            (CMS, "%s::%s" % (self.udn, CMS)),
        ]

    def location(self, peer_ip):
        return "http://%s:%d/description.xml" % (
            address_for_peer(peer_ip), self.http_port)

    def _open(self):
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except (AttributeError, OSError):
            pass
        sock.bind(("", SSDP_PORT))
        joined = 0
        for address in self.interface_addresses:
            try:
                membership = struct.pack("4s4s", socket.inet_aton(SSDP_ADDR),
                                         socket.inet_aton(address))
                sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP,
                                membership)
                joined += 1
            except OSError as exc:
                log.debug("SSDP: cannot join on %s: %s", address, exc)
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
        try:
            sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_LOOP, 0)
        except OSError:
            pass
        sock.settimeout(1.0)
        log.info("SSDP listening on %s:%d (joined %d interface(s))",
                 SSDP_ADDR, SSDP_PORT, joined)
        return sock

    def run(self):
        try:
            self.socket = self._open()
        except OSError as exc:
            log.error("SSDP: cannot bind %s:%d: %s", SSDP_ADDR, SSDP_PORT, exc)
            return
        try:
            self.announce("alive")
            self.last_announce = time.monotonic()
            while not self.stopping.is_set():
                try:
                    data, peer = self.socket.recvfrom(4096)
                except socket.timeout:
                    data = None
                except OSError as exc:
                    log.debug("SSDP recv: %s", exc)
                    continue
                if data:
                    try:
                        self._handle_datagram(data, peer)
                    except Exception:
                        log.exception("SSDP: bad datagram from %s", peer)
                if time.monotonic() - self.last_announce > SSDP_MAX_AGE / 2:
                    self.announce("alive")
                    self.last_announce = time.monotonic()
        finally:
            try:
                self.socket.close()
            except Exception:
                pass

    def _handle_datagram(self, data, peer):
        text = data.decode("utf-8", "replace")
        lines = text.splitlines()
        if not lines:
            return
        if not lines[0].upper().startswith("M-SEARCH"):
            return
        headers = parse_headers(lines[1:MAX_HEADERS])
        man = headers.get("man", "").strip().strip('"').lower()
        if man != "ssdp:discover":
            log.debug("SSDP: M-SEARCH without MAN ssdp:discover from %s", peer[0])
            return
        if not address_allowed(peer[0]):
            log.warning("SSDP: M-SEARCH refused from non-private address %s",
                        peer[0])
            return
        requested = headers.get("st", "").strip()
        if not requested:
            return
        if requested == "ssdp:all":
            self._send_replies(peer, self.targets())
            return
        matches = [pair for pair in self.targets() if pair[0] == requested]
        if matches:
            self._send_replies(peer, matches)
        else:
            log.debug("SSDP: no match for ST %s", requested)

    def _send_replies(self, peer, pairs):
        location = self.location(peer[0])
        for st, usn in pairs:
            reply = (
                "HTTP/1.1 200 OK\r\n"
                "CACHE-CONTROL: max-age=%d\r\n"
                "DATE: %s\r\n"
                "EXT:\r\n"
                "LOCATION: %s\r\n"
                "SERVER: %s\r\n"
                "ST: %s\r\n"
                "USN: %s\r\n"
                "BOOTID.UPNP.ORG: 1\r\n"
                "CONFIGID.UPNP.ORG: 1\r\n"
                "\r\n" % (SSDP_MAX_AGE,
                          time.strftime("%a, %d %b %Y %H:%M:%S GMT",
                                        time.gmtime()),
                          location, SERVER_HEADER, st, usn))
            try:
                self.socket.sendto(reply.encode("utf-8"), peer)
            except OSError as exc:
                log.debug("SSDP reply to %s failed: %s", peer, exc)
        log.info("SSDP: answered M-SEARCH from %s (%d entr%s)", peer[0],
                 len(pairs), "y" if len(pairs) == 1 else "ies")

    def announce(self, kind):
        """NOTIFY ssdp:alive or ssdp:byebye on every interface.

        One LOCATION per interface, not one for the whole host: a multi-homed
        board must announce an address that the interface it sends on can
        actually reach, or a client on the other LAN gets an unreachable URL."""
        if self.socket is None:
            return
        sent = 0
        for address in self.interface_addresses or ["127.0.0.1"]:
            try:
                self.socket.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF,
                                       socket.inet_aton(address))
            except OSError:
                continue
            location = "http://%s:%d/description.xml" % (address, self.http_port)
            for nt, usn in self.targets():
                lines = [
                    "NOTIFY * HTTP/1.1",
                    "HOST: %s:%d" % (SSDP_ADDR, SSDP_PORT),
                    "NT: %s" % nt,
                    "NTS: ssdp:%s" % kind,
                    "USN: %s" % usn,
                ]
                if kind == "alive":
                    lines += ["CACHE-CONTROL: max-age=%d" % SSDP_MAX_AGE,
                              "LOCATION: %s" % location,
                              "SERVER: %s" % SERVER_HEADER,
                              "BOOTID.UPNP.ORG: 1",
                              "CONFIGID.UPNP.ORG: 1"]
                payload = ("\r\n".join(lines) + "\r\n\r\n").encode("utf-8")
                try:
                    self.socket.sendto(payload, (SSDP_ADDR, SSDP_PORT))
                    sent += 1
                except OSError as exc:
                    log.debug("SSDP notify via %s: %s", address, exc)
        log.info("SSDP: %s announced (%d packets)", kind, sent)

    def shutdown(self):
        self.stopping.set()
        try:
            self.announce("byebye")
        except Exception:
            log.exception("SSDP: byebye failed")


