# HTTP server
# ---------------------------------------------------------------------------
class RendererHTTPRequestHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "kms-renderd/1.0"
    sys_version = ""

    # -- plumbing ----------------------------------------------------------

    def log_message(self, fmt, *args):
        log.debug("%s %s", self.client_address[0], fmt % args)

    def _allowed(self):
        peer = self.client_address[0]
        if address_allowed(peer):
            return True
        log.warning("refused %s %s from non-private address %s",
                    self.command, self.path, peer)
        return False

    def _send(self, status, body=b"", content_type="text/xml; charset=\"utf-8\"",
              extra_headers=None):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        for name, value in (extra_headers or {}).items():
            self.send_header(name, value)
        self.end_headers()
        if body:
            try:
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass

    def _body(self):
        if self.headers.get("Transfer-Encoding", "").lower() == "chunked":
            raise ValueError("chunked requests refused")
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            raise ValueError("invalid Content-Length")
        if length < 0:
            raise ValueError("invalid Content-Length")
        if length > MAX_BODY:
            raise OverflowError("body larger than %d bytes" % MAX_BODY)
        body = self.rfile.read(length) if length else b""
        if len(body) != length:
            raise ValueError("short body")
        return body

    # -- GET ---------------------------------------------------------------

    def do_GET(self):
        if not self._allowed():
            return self._send(403, b"forbidden", "text/plain")
        path = urllib.parse.urlparse(self.path).path
        renderer = self.server.renderer
        if path in ("/", "/description.xml"):
            body = device_description(self.server.udn, self.server.friendly_name,
                                      self.server.model_name).encode("utf-8")
            return self._send(200, body)
        service = PATH_SERVICE.get(path)
        if service and service[1] == "scpd":
            scpd = {
                "AVTransport": avtransport_scpd,
                "RenderingControl": renderingcontrol_scpd,
                "ConnectionManager": connectionmanager_scpd,
            }[service[0]]()
            return self._send(200, scpd.encode("utf-8"))
        log.info("GET %s -> 404", path)
        return self._send(404, b"not found", "text/plain")

    def do_HEAD(self):
        if not self._allowed():
            return self._send(403, b"forbidden", "text/plain")
        self._send(200, b"")

    # -- POST (SOAP) -------------------------------------------------------

    def do_POST(self):
        if not self._allowed():
            return self._send(403, b"forbidden", "text/plain")
        path = urllib.parse.urlparse(self.path).path
        service = PATH_SERVICE.get(path)
        if not service or service[1] != "control":
            return self._send(404, b"not found", "text/plain")
        service_name = service[0]
        try:
            body = self._body()
        except OverflowError as exc:
            log.warning("refused oversized body from %s: %s",
                        self.client_address[0], exc)
            return self._send(413, b"request too large", "text/plain")
        except ValueError as exc:
            log.warning("refused malformed request from %s: %s",
                        self.client_address[0], exc)
            return self._send(400, b"bad request", "text/plain")
        try:
            _namespace, action, arguments = parse_soap(body)
        except Exception as exc:
            log.warning("unparsable SOAP from %s: %s",
                        self.client_address[0], exc)
            return self._send(400, b"invalid XML", "text/plain")
        header = (self.headers.get("SOAPAction") or "").strip()
        if header:
            header = header.strip('"')
            if "#" in header:
                header_service, header_action = header.rsplit("#", 1)
                if header_action and header_action != action:
                    log.warning("SOAPAction %s does not match body action %s",
                                header_action, action)
                    return self._send(500, soap_fault(
                        401, "SOAPAction does not match the body").encode("utf-8"))
                if header_service and header_service != SERVICE_PATHS[service_name]["type"]:
                    # Some control points stamp the wrong namespace; the URL
                    # is authoritative. Log it, answer anyway.
                    log.warning("SOAPAction names %s on the %s endpoint",
                                header_service, service_name)
        else:
            # SOAPAction is mandatory in SOAP 1.1. Accepting the body action
            # keeps sloppy control points working, but the deviation is
            # logged: a clean answer beats a 400 the user cannot act on.
            log.info("SOAP request without SOAPAction from %s, using %s#%s",
                     self.client_address[0], service_name, action)
        try:
            result = self.server.renderer.handle(service_name, action, arguments)
        except UPnPError as exc:
            log.info("%s#%s refused: %d %s", service_name, action,
                     exc.code, exc.description)
            return self._send(500, soap_fault(exc.code, exc.description)
                              .encode("utf-8"))
        except Exception as exc:
            log.exception("%s#%s failed", service_name, action)
            return self._send(500, soap_fault(501, str(exc)[:120])
                              .encode("utf-8"))
        log.info("%s#%s ok", service_name, action)
        body = soap_response(SERVICE_PATHS[service_name]["type"], action,
                             result).encode("utf-8")
        return self._send(200, body)

    # -- SUBSCRIBE / UNSUBSCRIBE ------------------------------------------

    def _event_target(self):
        path = urllib.parse.urlparse(self.path).path
        service = PATH_SERVICE.get(path)
        if not service or service[1] != "event":
            return None
        return service[0]

    def do_SUBSCRIBE(self):
        if not self._allowed():
            return self._send(403, b"forbidden", "text/plain")
        service = self._event_target()
        if service is None:
            return self._send(404, b"not found", "text/plain")
        sid = (self.headers.get("SID") or "").strip()
        timeout = self.headers.get("TIMEOUT") or "Second-1800"
        if not re.match(r"^(Second-\d+|Second-infinite)$", timeout.strip()):
            timeout = "Second-1800"
        if sid:
            if not self.server.events.renew(sid):
                return self._send(412, b"unknown subscription", "text/plain")
            log.info("SUBSCRIBE renew %s", sid)
            return self._send(200, b"", 'text/xml; charset="utf-8"',
                              {"SID": sid, "TIMEOUT": timeout})
        callback = (self.headers.get("CALLBACK") or "").strip()
        nt = (self.headers.get("NT") or "").strip()
        if nt != "upnp:event" or not callback.startswith("<"):
            return self._send(412, b"missing CALLBACK or NT", "text/plain")
        new_sid = self.server.events.create(service, callback, timeout)
        log.info("SUBSCRIBE %s %s (%s)", service, new_sid, callback[:80])
        return self._send(200, b"", 'text/xml; charset="utf-8"',
                          {"SID": new_sid, "TIMEOUT": timeout})

    def do_UNSUBSCRIBE(self):
        if not self._allowed():
            return self._send(403, b"forbidden", "text/plain")
        if self._event_target() is None:
            return self._send(404, b"not found", "text/plain")
        sid = (self.headers.get("SID") or "").strip()
        if not sid or not self.server.events.remove(sid):
            return self._send(412, b"unknown subscription", "text/plain")
        log.info("UNSUBSCRIBE %s", sid)
        return self._send(200)


class SubscriptionRegistry:
    """SIDs only: no NOTIFY is sent, but renewal and removal behave."""

    def __init__(self):
        self.lock = threading.Lock()
        self.items = {}

    def create(self, service, callback, timeout):
        sid = "uuid:%s" % hashlib.md5(
            ("%s|%s|%s" % (service, callback, time.time())).encode()).hexdigest()
        with self.lock:
            self.items[sid] = {"service": service, "callback": callback,
                               "timeout": timeout, "created": time.time()}
        return sid

    def renew(self, sid):
        with self.lock:
            return sid in self.items

    def remove(self, sid):
        with self.lock:
            return self.items.pop(sid, None) is not None


class RendererHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 16

    def handle_error(self, request, client_address):
        # A malformed request must never take the daemon down: the handler
        # already answers what it can, this is the last line of defence.
        log.exception("HTTP handler error from %s", client_address)


