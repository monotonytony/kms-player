class Renderer:
    """Stateless view over PlayerManager: one method per UPnP action."""

    def __init__(self, players):
        self.players = players

    def handle(self, service, action, arguments):
        handler = getattr(self, "_%s_%s" % (service, action), None)
        if handler is None:
            raise UPnPError(401, "unknown action %s" % action)
        # UPnP AV defines exactly one instance per renderer; anything else is
        # 718. Checked here rather than in every action so no handler can
        # forget it.
        if service in ("AVTransport", "RenderingControl"):
            instance = arguments.get("InstanceID")
            if instance is None:
                raise UPnPError(402, "missing InstanceID")
            try:
                instance = int(str(instance).strip())
            except ValueError:
                raise UPnPError(718, "invalid InstanceID")
            if instance != 0:
                raise UPnPError(718, "invalid InstanceID")
        return handler(arguments) or {}

    # -- AVTransport -------------------------------------------------------

    def _AVTransport_SetAVTransportURI(self, args):
        self.players.set_uri(args.get("CurrentURI"),
                             args.get("CurrentURIMetaData"))
        return {}

    def _AVTransport_SetNextAVTransportURI(self, args):
        self.players.set_next_uri(args.get("NextURI"),
                                  args.get("NextURIMetaData"))
        return {}

    def _AVTransport_GetMediaInfo(self, args):
        state = self.players.snapshot()
        return {
            "NrTracks": "1" if state["uri"] else "0",
            "MediaDuration": hms(state["duration"]),
            "CurrentURI": state["uri"],
            "CurrentURIMetaData": state["metadata"],
            "NextURI": state["next_uri"],
            "NextURIMetaData": state["next_metadata"],
            "PlayMedium": "NETWORK" if state["uri"] else "NONE",
            "RecordMedium": "NOT_IMPLEMENTED",
            "WriteStatus": "NOT_IMPLEMENTED",
        }

    def _AVTransport_GetTransportInfo(self, args):
        state = self.players.snapshot()
        return {
            "CurrentTransportState": state["state"],
            "CurrentTransportStatus": state["status"],
            "CurrentSpeed": "1",
        }

    def _AVTransport_GetPositionInfo(self, args):
        state = self.players.snapshot()
        return {
            "Track": "1" if state["uri"] else "0",
            "TrackDuration": hms(state["duration"]),
            "TrackMetaData": state["metadata"],
            "TrackURI": state["uri"],
            "RelTime": hms(state["position"]),
            "AbsTime": hms(state["position"]),
            "RelCount": "2147483647",
            "AbsCount": "2147483647",
        }

    def _AVTransport_GetDeviceCapabilities(self, args):
        return {
            "PlayMedia": "NETWORK",
            "RecMedia": "NOT_IMPLEMENTED",
            "RecQualityModes": "NOT_IMPLEMENTED",
        }

    def _AVTransport_GetTransportSettings(self, args):
        return {"PlayMode": "NORMAL", "RecQualityMode": "NOT_IMPLEMENTED"}

    def _AVTransport_GetCurrentTransportActions(self, args):
        state = self.players.snapshot()["state"]
        actions = {
            "STOPPED": "Play,Seek",
            "PLAYING": "Pause,Stop,Seek",
            "PAUSED_PLAYBACK": "Play,Stop,Seek",
            "TRANSITIONING": "Stop",
            "NO_MEDIA_PRESENT": "",
        }.get(state, "Play,Stop,Pause,Seek")
        return {"Actions": actions}

    def _AVTransport_Play(self, args):
        speed = (args.get("Speed") or "1").strip()
        if speed not in ("1", "1.0", ""):
            raise UPnPError(717, "play speed not supported")
        self.players.play()
        return {}

    def _AVTransport_Pause(self, args):
        self.players.pause()
        return {}

    def _AVTransport_Stop(self, args):
        self.players.stop()
        return {}

    def _AVTransport_Seek(self, args):
        self.players.seek(args.get("Unit"), args.get("Target"))
        return {}

    def _AVTransport_Next(self, args):
        raise UPnPError(701, "no next track")

    def _AVTransport_Previous(self, args):
        raise UPnPError(701, "no previous track")

    # -- RenderingControl --------------------------------------------------

    def _RenderingControl_GetVolume(self, args):
        return {"CurrentVolume": str(self.players.get_volume())}

    def _RenderingControl_SetVolume(self, args):
        self.players.set_volume(args.get("DesiredVolume"))
        return {}

    def _RenderingControl_GetMute(self, args):
        return {"CurrentMute": "1" if self.players.get_mute() else "0"}

    def _RenderingControl_SetMute(self, args):
        value = (args.get("DesiredMute") or "").strip().lower()
        if value not in ("0", "1", "true", "false", "yes", "no"):
            raise UPnPError(402, "invalid mute value")
        self.players.set_mute(value in ("1", "true", "yes"))
        return {}

    def _RenderingControl_ListPresets(self, args):
        return {"CurrentPresetNameList": "FactoryDefaults"}

    def _RenderingControl_SelectPreset(self, args):
        name = (args.get("PresetName") or "").strip()
        if name != "FactoryDefaults":
            raise UPnPError(701, "unknown preset")
        return {}

    # -- ConnectionManager -------------------------------------------------

    def _ConnectionManager_GetProtocolInfo(self, args):
        return {"Source": "", "Sink": SINK_PROTOCOL_INFO}

    def _ConnectionManager_GetCurrentConnectionIDs(self, args):
        return {"ConnectionIDs": "0"}

    def _ConnectionManager_GetCurrentConnectionInfo(self, args):
        try:
            connection = int(args.get("ConnectionID") or 0)
        except ValueError:
            raise UPnPError(402, "invalid ConnectionID")
        if connection != 0:
            raise UPnPError(706, "invalid connection")
        return {
            "RcsID": "0", "AVTransportID": "0", "ProtocolInfo": "",
            "PeerConnectionManager": "", "PeerConnectionID": "-1",
            "Direction": "Input", "Status": "OK",
        }


