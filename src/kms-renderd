class UPnPError(Exception):
    """A SOAP fault with a UPnP error code (701, 402, 718, ...)."""

    def __init__(self, code, description=None):
        super().__init__(description or ERROR_TEXT.get(code, "Action Failed"))
        self.code = code
        self.description = description or ERROR_TEXT.get(code, "Action Failed")


ERROR_TEXT = {
    401: "Invalid Action",
    402: "Invalid Args",
    501: "Action Failed",
    701: "Transition not available",
    702: "No contents",
    710: "Seek mode not supported",
    718: "Invalid InstanceID",
    720: "Cannot process the request",
    721: "Resource busy",
}


