def _state_variable(name, data_type, values=None, default=None,
                    send_events="no"):
    parts = ['<stateVariable sendEvents="%s"><name>%s</name>'
             "<dataType>%s</dataType>" % (send_events, name, data_type)]
    if default is not None:
        parts.append("<defaultValue>%s</defaultValue>" % xml_text(default))
    if values:
        parts.append("<allowedValueList>%s</allowedValueList>"
                     % "".join("<allowedValue>%s</allowedValue>" % xml_text(v)
                               for v in values))
    parts.append("</stateVariable>")
    return "".join(parts)


def _action(name, arguments=()):
    parts = ["<action><name>%s</name>" % name]
    if arguments:
        parts.append("<argumentList>")
        for arg_name, direction, related in arguments:
            parts.append(
                "<argument><name>%s</name><direction>%s</direction>"
                "<relatedStateVariable>%s</relatedStateVariable></argument>"
                % (arg_name, direction, related))
        parts.append("</argumentList>")
    parts.append("</action>")
    return "".join(parts)


def _scpd(actions, variables):
