DEFAULT_CONTROL_SOCKET = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or ("/run/user/%d" % UID),
    "kms-play.sock")
if not os.path.isdir(os.path.dirname(DEFAULT_CONTROL_SOCKET)):
    DEFAULT_CONTROL_SOCKET = "/tmp/kms-play-%d.sock" % UID


def stable_uuid(friendly_name):
    """A UDN that survives restarts, kept next to the player's cache."""
    directory = os.path.expanduser("~/.cache/kms-renderd")
    path = os.path.join(directory, "uuid")
    try:
        with open(path) as handle:
            value = handle.read().strip()
            if re.match(r"^uuid:[0-9a-f-]{36}$", value):
                return value
    except OSError:
        pass
    seed = "%s|%s|%s" % (socket.gethostname(), friendly_name, os.uname().machine)
    digest = hashlib.md5(seed.encode("utf-8")).hexdigest()
    value = "uuid:%s-%s-%s-%s-%s" % (digest[:8], digest[8:12], digest[12:16],
                                    digest[16:20], digest[20:32])
    try:
        os.makedirs(directory, exist_ok=True)
        with open(path, "w") as handle:
            handle.write(value + "\n")
    except OSError as exc:
        log.warning("cannot persist the UDN in %s: %s", path, exc)
    return value


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Minimal UPnP MediaRenderer driving kms-play")
    parser.add_argument("--http-port", type=int,
                        default=int(os.environ.get("KMS_RENDERD_HTTP_PORT",
                                                   "8200")),
                        help="HTTP port for description, SOAP and eventing")
    parser.add_argument("--friendly-name",
                        default=os.environ.get("KMS_RENDERD_NAME",
                                               "KMS Player (BPI-M7)"))
    parser.add_argument("--model-name", default="kms-renderd")
    parser.add_argument("--player",
                        default=os.environ.get("KMS_RENDERD_PLAYER",
                                               "/usr/local/bin/kms-play"),
                        help="player command, run as '<player> <uri>'")
    parser.add_argument("--control-socket",
                        default=os.environ.get("KMS_RENDERD_CONTROL_SOCKET",
                                               DEFAULT_CONTROL_SOCKET))
    parser.add_argument("--uuid", default=None,
                        help="UDN override (default: stable, cached)")
    parser.add_argument("--log-level", default="INFO")
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=getattr(logging, args.log_level.upper(), logging.INFO),
        format="%(asctime)s kms-renderd %(levelname)s %(message)s")

    import shlex
    player_command = shlex.split(args.player)
    if not player_command:
        parser.error("--player is empty")

    udn = args.uuid or stable_uuid(args.friendly_name)
    if not udn.startswith("uuid:"):
        udn = "uuid:" + udn

    players = PlayerManager(args.control_socket, player_command)
    renderer = Renderer(players)

    try:
        httpd = RendererHTTPServer(("0.0.0.0", args.http_port),
                                   RendererHTTPRequestHandler)
    except OSError as exc:
        log.error("cannot listen on port %d: %s", args.http_port, exc)
        players.shutdown()
        return 1
    httpd.renderer = renderer
    httpd.udn = udn
    httpd.friendly_name = args.friendly_name
    httpd.model_name = args.model_name
    httpd.events = SubscriptionRegistry()

    ssdp = SSDPServer(udn, args.http_port, args.friendly_name)

    stop = threading.Event()

    def on_signal(signum, _frame):
        log.info("signal %d, shutting down", signum)
        stop.set()

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    http_thread = threading.Thread(target=httpd.serve_forever,
                                   name="kms-renderd-http", daemon=True)
    http_thread.start()
    ssdp.start()

    log.info("ready: %s | %s | http://0.0.0.0:%d/description.xml",
             udn, args.friendly_name, args.http_port)
    log.info("player command: %s", " ".join(player_command))
    log.info("player control socket: %s", args.control_socket)
    log.info("UPnP has no authentication: never expose port %d on the internet",
             args.http_port)

    while not stop.wait(0.5):
        pass

    ssdp.shutdown()
    httpd.shutdown()
    httpd.server_close()
    players.shutdown()
    log.info("stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
