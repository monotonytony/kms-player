def address_allowed(text):
    """True when an address is private, link-local or loopback.

    IPv4-mapped IPv6 addresses (::ffff:192.168.1.2) are unmapped first. A
    scope id (fe80::1%eth0) is stripped. Anything unparsable is refused.
    """
    try:
        address = ipaddress.ip_address(text.split("%", 1)[0])
    except ValueError:
        return False
    if address.version == 6 and address.ipv4_mapped is not None:
        address = address.ipv4_mapped
    return any(address in network for network in ALLOWED_NETS)


def hms(seconds):
    """UPnP time format: H+:MM:SS (hours not zero-padded)."""
    seconds = max(0, int(round(float(seconds or 0))))
    return "%d:%02d:%02d" % (seconds // 3600, (seconds % 3600) // 60,
                             seconds % 60)


def parse_time(text):
    """Parse 'H:MM:SS', 'HH:MM:SS.mmm', 'MM:SS' or a plain number of seconds."""
    text = (text or "").strip()
    if not text:
        raise UPnPError(402, "empty seek target")
    if ":" not in text:
        try:
            return max(0.0, float(text))
        except ValueError:
            raise UPnPError(402, "invalid seek target")
    parts = text.split(":")
    if len(parts) > 3:
        raise UPnPError(402, "invalid seek target")
    try:
        values = [float(part) for part in parts]
    except ValueError:
        raise UPnPError(402, "invalid seek target")
    seconds = 0.0
    for value in values:
        seconds = seconds * 60.0 + value
    return max(0.0, seconds)


def local_ipv4_addresses():
    """Every non-loopback IPv4 address of this host, without a subprocess."""
    addresses = set()
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            addresses.add(info[4][0])
    except Exception:
        pass
    # The address of the default route, found without sending a packet.
    try:
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            probe.connect(("192.0.2.1", 9))
            addresses.add(probe.getsockname()[0])
        finally:
            probe.close()
    except OSError:
        pass
    return sorted(address for address in addresses
                  if not address.startswith("127."))


def address_for_peer(peer_ip, fallback="127.0.0.1"):
    """The local address a peer can reach, best effort.

    Choosing the LOCATION interface by hand is what makes SSDP work on a
    multi-homed board: the reply must announce the address of the interface
    that received the M-SEARCH, not an arbitrary one.
    """
    try:
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            probe.connect((peer_ip, 9))
            return probe.getsockname()[0]
        finally:
            probe.close()
    except OSError:
        addresses = local_ipv4_addresses()
        return addresses[0] if addresses else fallback


def parse_headers(lines):
    headers = {}
    for line in lines:
        if ":" not in line:
            continue
        name, value = line.split(":", 1)
        headers[name.strip().lower()] = value.strip()
    return headers


def xml_text(text):
    return xml_escape(str(text or ""))


def soap_envelope(body):
    return (
        '<?xml version="1.0" encoding="utf-8"?>\n'
        '<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
        's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">'
        "<s:Body>%s</s:Body></s:Envelope>" % body)


def soap_response(service_type, action, arguments):
    parts = ['<u:%sResponse xmlns:u="%s">' % (action, service_type)]
    for name, value in arguments.items():
        parts.append("<%s>%s</%s>" % (name, xml_text(value), name))
    parts.append("</u:%sResponse>" % action)
    return soap_envelope("".join(parts))


def soap_fault(code, description):
    return soap_envelope(
        "<s:Fault><faultcode>s:Client</faultcode>"
        "<faultstring>UPnPError</faultstring><detail>"
        '<UPnPError xmlns="urn:schemas-upnp-org:control-1-0">'
        "<errorCode>%d</errorCode><errorDescription>%s</errorDescription>"
        "</UPnPError></detail></s:Fault>" % (code, xml_escape(description)))


def parse_soap(data):
    """Parse a SOAP request body, refusing anything with a DTD.

    xml.etree does not fetch external entities, but an internal entity
    expansion is still a denial of service vector, and DOCTYPE has no reason
    to appear in a SOAP action. Refusing it outright is cheaper than reasoning
    about expat's limits.
    """
    text = data.decode("utf-8", "strict")
    upper = text.upper()
    if "<!DOCTYPE" in upper or "<!ENTITY" in upper:
        raise ValueError("DOCTYPE/ENTITY refused")
    root = ET.fromstring(text)
    body = None
    for child in root:
        if child.tag.endswith("}Body") or child.tag == "Body":
            body = child
            break
    if body is None or len(body) == 0:
        raise ValueError("no SOAP body")
    action_element = body[0]
    tag = action_element.tag
    if "}" in tag:
        namespace, action = tag.split("}", 1)
        namespace = namespace[1:]
    else:
        namespace, action = "", tag
    arguments = {}
    for argument in action_element:
        name = argument.tag.split("}", 1)[-1]
        arguments[name] = argument.text if argument.text is not None else ""
    return namespace, action, arguments


